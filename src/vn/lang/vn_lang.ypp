%require "3.2"

%language "c++"
%define api.namespace {YY}
%define api.parser.class {VNLangParser}
%define api.value.type variant
%define api.token.constructor
%define parse.error detailed
// Inadequacy Elimination LR
%define lr.type ielr
// Lookahead Correction
%define parse.lac full
%define parse.trace

%defines

%locations
%define api.location.file "vn_lang.location.hpp"

%code requires {
  // Appears high-ish in the generated .hpp file
  // Use full paths because we can be included from elsewhere and build/src/x is not "near" src/x
  
  #include <string>
  #include "vn/lang/vn_types.hpp"     
  #include "node/tree_ptr.hpp"

  struct ANDBlock;

  namespace YY {
    class VNLangScanner;  
  	struct TokenMetadata
	{
		TreePtr<Node> node;
		string as_ascii;
		wstring as_unicode;
		const ANDBlock *as_andata_block;
	};     	
  };
  
  namespace VN { 
    // Things we point to from semantic values
    class Command;
    class Gnomon;
    class ResolverGnomon;
    // Infrastructure
    class VNLangActions;
	class VNLangRecogniser;
  }
}

%code { 
  // Appears high-ish in the generated .cpp file
  #include "vn_lang.lpp.hpp"  /* Generated by reflex. */
  #include "vn_commands.hpp"
  #include "vn_actions.hpp"     
  #include "declarators.hpp" 
  #include "tree/node_names.hpp"  
  #include "vn_recogniser.hpp"
  #include <iostream>
  #include <fstream>  
   
  #undef yylex
  #define yylex lexer.lex  /* Within bison's parse() we should invoke lexer.lex(), not the global yylex() */
  
  // Strings that could be translated have _() around them. 
  // See https://www.gnu.org/software/gettext/manual/gettext.html
  #define _(String) (String)
  #define N_(String) String 
}

%parse-param { YY::VNLangScanner& lexer }
%parse-param { VN::VNLangActions *vn }
%parse-param { VN::VNLangRecogniser *recogniser }

%define api.token.prefix {TOK_}

%token
	DESIGNATE_COMMAND 					        _("designate command ⪮")
	ENGINE_COMMAND	 						    _("engine command ꩜")
	ATTRIBUTE_COMMAND						    _("attribute command ‡")
	COMMAND_TERM 						        _("command terminator ⨟")
	OPEN_VN 							        _("open VN-params ⦅")
	CLOSE_VN 							        _("close VN-params ⦆")
	VN_SEP 								        _("VN-param separator ⚬")
	VN_SUB_SEP							        _("container separator 🞄")
	OPEN_MAP_CALL						        _("open map-arguments 〔")
	CLOSE_MAP_CALL						        _("close map-arguments 〕")	
	MAP_ARG_OP 							        _("map-argument operator ⦂")
	STUFF_OP		 					        _("stuff operator ⩨")
	DELTA_COMPARE_OP 					        _("delta-compare operator ▲")
	DELTA_REPLACE_OP 					        _("delta-replace operator ⯈")
	DELTA_END_OP 					 	        _("delta-end operator ⯇")
	EXPLICIT_OP 						        _("explicit node operator ⯁")
	ANY_NODE_OP 						        _("any node operator ☆")
	STAR_OP 							        _("star operator ★")
	ID_BY_NAME_OP						        _("identifier-by-name operator ⊛")
	BUILDER_ID_OP						        _("node-builder operator ⧇")
	TRANSFORM_OP						        _("transform operator ⤨")
	NEGATION_OP							        _("negation operator ¬")
	CONJUNCTION_OP						        _("conjunction operator ∧")
	DISJUNCTION_OP						        _("disjunction operator ∨")
	GREEN_GRASS_OP						        _("green-grass operator ⫴")
	POINTER_IS_OP							    _("pointer-is operator ⮎")
	BUILD_SIZE_OP							    _("build-container-size operator 🄽")
	STRINGIZE_OP							    _("stringise operator §")
	PRERESTRICT_OP						        _("prerestriction operator ‽")
	XSTRUCTOR							        _("constructor/destructor virtual type ⨤")
	TYPE_INDICATOR						        _("type indicator ⍑")
	CODE_UNIT 							        _("code unit ∞")
	RESOLUTION_OP 						        _("C scope-resolution operator ::")
	RANGE_OP 							        _("GCC range operator ..")
    STATIC_KEYWORD								_("C static keyword")
	TYPENAME_KEYWORD						            _("C++ typename keyword")
	ELSE_KEYWORD					 		_("C chaining keyword") // eg else
		
<string>	C_ASSIGN				        _("C assignment operator =")
<string>	C_COMPOUND_ASSIGN				_("C compound-assignment operator")
<string>	C_LOGICAL_OR_OP			        _("C logical-or operator ||")		
<string>	C_LOGICAL_AND_OP		        _("C logical-and operator &&")
<string>	C_BITWISE_OR_OP			        _("C bitwise-or operator |")
<string>	C_BITWISE_XOR_OP		        _("C bitwise-xor operator ^")
<string>	C_EQUALITY_OP					_("C equality operator ==")
<string>  	C_RELATIONAL_OP					_("C relational operator")
<string>	C_SHIFT_OP						_("C shift operator operator")
<string>	C_ADD_SUB_OP					_("C add/subtract operator")
<string>    C_DIV_MOD_OP					_("C divide/modulo operator")
<string>  	C_PREFIX_OP						_("C prefix operator")
<string>	C_PRE_OR_INFIX_OP				_("C prefix/infix operator")
<string>    C_PRE_OR_POSTFIX_OP 			_("C prefix/postfix operator")
<wstring> 	STRING_LITERAL 					_("C string literal")
<string> 	INTEGRAL_LITERAL				_("C integer literal")
<string>	ASCII_FORMAT 					_("C format string")
<string>	TYPE_SPECIFIER					_("C simple type specifier")
<YY::TokenMetadata> TRANSFORM_NAME_TYPE		_("type transform name")
<YY::TokenMetadata> TRANSFORM_NAME_NORMAL	_("open_statement transform name")
<YY::TokenMetadata> ASCII_NAME 				_("ASCII name")
<YY::TokenMetadata> UNICODE_NAME 			_("Unicode name")
<TreePtr<Node>>	DESIGNATED_NORMAL		_("designated statement/expression name")
<TreePtr<Node>>	DESIGNATED_TYPE			_("designated type name")
<TreePtr<Node>>	DESIGNATED_DECL			_("designated declaration name")
<TreePtr<Node>>	DESIGNATED_QUAL			_("designated qualifier name")
<TreePtr<Node>>	DESIGNATED_COMPOUND		_("designated compound name")
<YY::TokenMetadata>	RESOLVED_NORMAL			_("resolved open_statement node name")
<YY::TokenMetadata>	RESOLVED_TYPE			_("resolved type node name")
<YY::TokenMetadata>	RESOLVED_DECL			_("resolved declaration node name")
<YY::TokenMetadata>	RESOLVED_QUAL			_("resolved qualifier node name")
<YY::TokenMetadata>	RESOLVED_MEMB_INIT		_("resolved member initialiser node name")
<YY::TokenMetadata>	NODE_NAMESPACE			_("scope resolving name")
<TreePtr<Node>>	BOOL_LITERAL			_("C boolean literal")
<TreePtr<Node>> KEYWORD_PRIMARY_OP		_("open_statement keyword operator")
<TreePtr<Node>> KEYWORD_SIMPLE_STMT     _("keyword simple statement") // eg break;
<TreePtr<Node>> KEYWORD_SPACE_SEP_STMT 	_("keyword space-separated statement") // eg return 12;
<TreePtr<Node>> KEYWORD_ARGS_BODY_STMT 	_("keyword args-and-body statement") // eg switch(args) body
<TreePtr<Node>> KEYWORD_ARGS_BODY_WITH_ELSE 	_("keyword args-body-chain statement") // eg if(args) body else body_else	
<TreePtr<Node>> DO_KEYWORD				_("C do keyword")
<TreePtr<Node>> WHILE_KEYWORD			_("C while keyword")
<TreePtr<Node>> CASE_KEYWORD			_("C case keyword")
<TreePtr<Node>> DEFAULT_KEYWORD			_("C default keyword")
<TreePtr<Node>> FUNC_ON_TYPE			_("function acting on a type")
<TreePtr<Node>> IRECORD_KEYWORD			_("C class/struct/union keyword")
<TreePtr<Node>> ENUM_KEYWORD			_("C enumeration keyword")
<TreePtr<Node>> QUAL_NODE_KEYWORD		_("C qualifier")
<TreePtr<Node>> TYPEDEF_KEYWORD			_("C typedef keyword")
<TreePtr<Node>> TYPE_KEYWORD			_("C type keyword")
stmt_low 
stmt_high
	
%type <TreePtr<Node>> 				expr_primary expr_postfix expr_prefix expr_relational 
%type <TreePtr<Node>> 				stmt_entry stmt_disjunction stmt_conjunction open_statement 
%type <TreePtr<Node>> 				stmt_entry_nc stmt_disjunction_nc stmt_conjunction_nc open_statement_nc 
%type <TreePtr<Node>> 				expr_assignment expr_equality expr_add_etc expr_logical_or expr_logical_and 
%type <TreePtr<Node>> 				expr_mul_etc expr_shift expr_bitwise_and expr_bitwise_or expr_bitwise_xor  
%type <TreePtr<Node>> 				expr_comma_op expr_no_comma_op expr_entry expr_id_value stmt_boot
%type <TreePtr<Node>> 				id_primary id_wildcard
%type <TreePtr<Node>> 				type_specified type_primary type_postfix type_prefix type_vn_prim 
%type <TreePtr<Node>> 				type_disjunction type_conjunction
%type <TreePtr<Node>> 				unified_entry unified_prefix 
%type <TreePtr<Node>> 				arrival
%type <TreePtr<Node>> 				bare_statement statement_nl stmt_comp statement         
%type <list<TreePtr<Node>>>			statement_l statement_e stmt_decl_l statement_nc
%type <TreePtr<Node>> 				open_declaration decl_boot decl_entry decl_disjunction decl_conjunction declaration 
%type <TreePtr<Node>> 				prototype bare_decl_nvn comp_decl_nvn bare_declaration bare_initialiser
%type <TreePtr<Node>> 				assign_init
%type <TreePtr<Node>> 				decl_prefix decl_postfix decl_primary decl_vn_prim
%type <TreePtr<Node>> 				compound_primary parameter type_boot type_entry compound_prefix compound_entry 
//%type <TreePtr<Node>> 			compound_commands compound_boot
%type <TreePtr<Node>> 				type_for_declarator 
%type <TreePtr<Node>> 				declarator declarator_prefix declarator_postfix declarator_primary
%type <TreePtr<Node>> 				type_id 
%type <TreePtr<Node>> 				ab_type ab_declarator ab_declarator_prefix ab_declarator_postfix 
%type <TreePtr<Node>> 				irecord_node inheritance_record base_spec access_spec access_clause qualifier_node
%type <TreePtr<Node>> 				enum_node enum
%type <TreePtr<Node>>				memb_init_boot memb_init_entry memb_init_prefix memb_init_postfix memb_init_primary
%type <wstring> 					vn_name
%type <string>						transform_op_named type_transform_op_named mi_transform_op_named
%type <YY::TokenMetadata> 			node_namespace
%type <YY::TokenMetadata> 			resolved_norm_name resolved_type_name resolved_decl_name resolved_qual_name resolved_mi_name
%type <TreePtr<Node>>	 			resolved_norm_node resolved_type_node resolved_decl_node resolved_qual_node resolved_mi_node
%type <TreePtr<Node>>	 			explicit_norm_node explicit_type_node explicit_decl_node explicit_qual_node explicit_mi_node
%type <list<shared_ptr<VN::Command>>>			commands sep_commands decl_commands
%type <shared_ptr<VN::Command>>		script_command 
%type <VN::Limit>					stuff_depth
%type <VN::Itemisation>				itemisation items_bare items_sep
%type <VN::Item>					item
%type <shared_ptr<VN::Gnomon>>		part_resolve designation_command 
%type <shared_ptr<VN::Gnomon>>		transform_op_scope
%type <shared_ptr<VN::Gnomon>>		explicit_op_scope prerestrict_op_scope id_by_name_op_scope builder_id_op_scope stuff_op_scope
%type <shared_ptr<VN::Gnomon>>		code_unit_scope compound_scope params_scope 
%type <shared_ptr<VN::PrerestrictScopeGnomon>>		decl_prerestrict_op_named
%type <VN::NodeAndGnomon>			norm_full_explicit_start type_full_explicit_start decl_full_explicit_start qual_full_explicit_start mi_full_explicit_start
%type <VN::NodeAndGnomon>			irecord_scope enum_scope
%type <TreePtr<Node>> 				acc_memb_boot member comp_member bare_member bare_member_nvn 
%type <TreePtr<Node>> 				acc_memb_prefix acc_memb_postfix acc_memb_paren acc_memb_primary
%type <list<TreePtr<Node>>>			stmt_decls members enumerators
%type <TreePtr<Node>> 				enumerator prototype_enumerator
%type <list<TreePtr<Node>>>			comma_sep_expr_decl semicolon_args parameters parameterisation
%type <list<TreePtr<Node>>>			bases memb_inits
%type <VN::QualifierData> 			qualifier qualifier_nw
%type <list<VN::QualifierData>>		qualifiers 
%type <TreePtr<Node>> prerestrict_op_named id_by_name_op_named build_id_named 
%type <TreePtr<Node>> type_prerestrict_op_named type_id_by_name_op_named type_build_id_op_named
%type <TreePtr<Node>> mi_prerestrict_op_named mi_id_by_name_op_named mi_build_id_op_named
%type <multiset<string>>			type_specifier_seq

// Solve the dangling-else amiguity by giving the "else" token a higher priority than the "if" token
// In the rule, we must set the no-else rule to the "if" priority using %prec. Then, the TOKEN
// for "else" will be compared with the RULE for no-else case and highest precidence will win.
// It's all rather brittle.
%precedence KEYWORD_ARGS_BODY_WITH_ELSE // basically "then"
%precedence ELSE_KEYWORD  			     // basically "else"

%%

//////////////////////////////////// COMMANDS ///////////////////////////////////////////

vnscript 		: commands 								{ vn->OnVNScript($1); }
     
stmt_boot		: commands								{ $$ = vn->OnEmbeddedCommands($1); }
     
// This is to make the ⨟ optional on last command
commands        : sep_commands								{ $$ = $1; }
				| sep_commands COMMAND_TERM					{ $$ = $1; }
				
// The ⨟ turns patterns into commands. 
sep_commands 	: sep_commands COMMAND_TERM script_command		{ $$ = $1; $$.push_back($3); }	
				| script_command								{ $$.push_back($1); }
				| sep_commands COMMAND_TERM designation_command	{ $$ = $1; recogniser->AddGnomon($3); }	
				| designation_command							{ recogniser->AddGnomon($1); }
			
// Add more commands here
script_command	: ENGINE_COMMAND unified_entry   		 	{ $$ = make_shared<VN::EngineCommand>($2, @1); }
				| stmt_entry 			  					{ $$ = make_shared<VN::PatternCommand>($1, @$); } // in trivial cases, this decays back to the node
				| ATTRIBUTE_COMMAND		  					{ $$ = make_shared<VN::AttributeCommand>(@$); }

// or here
designation_command	: vn_name DESIGNATE_COMMAND stmt_entry_nc		{ $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_NORMAL); }
					| vn_name DESIGNATE_COMMAND type_entry			{ $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_TYPE); }
					| vn_name DESIGNATE_COMMAND decl_entry			{ $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_DECL); }
					| vn_name DESIGNATE_COMMAND qualifier_node		{ $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_QUAL); }
					| vn_name DESIGNATE_COMMAND compound_entry    	{ $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_COMPOUND); }
					
//////////////////////////////////// ITEMISATION ///////////////////////////////////////////
// For explicit/built-in nodes mostly

itemisation	: OPEN_VN items_bare CLOSE_VN  			{ $$ = $2; $$.loc = @$; }
			| OPEN_VN items_sep CLOSE_VN			{ $$ = $2; $$.loc = @$; $$.items.push_back({{}, @3}); }
			| OPEN_VN CLOSE_VN						{ $$.loc = @$; }
					
items_bare 	: items_sep item						{ $$ = $1; $$.items.push_back($2); }
			| item									{ $$.items.push_back($1); }

items_sep 	: items_bare VN_SEP		   				{ $$ = $1; } 
			| items_sep VN_SEP		 				{ $$ = $1; $$.items.push_back({{}, @2}); }
			| VN_SEP	 							{ $$.items.push_front({{}, @1}); }

item		: item VN_SUB_SEP unified_entry			{ $$ = $1; $$.nodes.push_back($3); $$.loc = @$; }
			| unified_entry							{ $$.nodes.push_back($1); $$.loc = @$; }

//////////////////////////////// UNIFIED ////////////////////////////////////         

// Entry is like boot but without commands
unified_entry	: stmt_entry
				| type_entry
				| decl_entry
				| qualifier_node			

unified_prefix	: expr_prefix
				| type_prefix
				| decl_prefix
  
//////////////////////////////// COMPOUND ////////////////////////////////////         

//compound_boot	: compound_entry								
//				| compound_commands										{ $$ = vn->OnEmbeddedCommands($1); }

//compound_commands	: compound_entry COMMAND_TERM commands					{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 

// Because there's no separator in {{code} expr} the prefix ops would conflict with infix that use same symbol,
// so we'll need to complete a branch of the syntax for compounds with a copy of the unary VN operators (none are postfix).
compound_entry	: compound_prefix

compound_prefix : compound_primary 
				| 								NEGATION_OP compound_prefix	{ $$ = vn->OnNegation($2); }
				|       				 transform_op_named compound_prefix	{ $$ = vn->OnTransform($1, @1, $2, @2); }
				|  								   stuff_op_scope compound_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
				|    stuff_op_scope OPEN_VN unified_entry CLOSE_VN compound_prefix	{ $$ = vn->OnStuff($5, $3, VN::Limit()); }
				|     stuff_op_scope OPEN_VN stuff_depth CLOSE_VN compound_prefix	{ $$ = vn->OnStuff($5, nullptr, $3); }
				|                      prerestrict_op_named compound_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }

compound_primary	: compound_scope '{' VN_SEP '}'                			{ $$ = vn->OnCompound({}, @3, {}, @3); } 
					| compound_scope '{' stmt_decls VN_SEP '}'     			{ $$ = vn->OnCompound($3, @3, {}, @5); }
					| compound_scope '{' VN_SEP stmt_decls '}'     			{ $$ = vn->OnCompound({}, @3, $4, @4); }
					| compound_scope '{' stmt_decls VN_SEP stmt_decls '}'	{ $$ = vn->OnCompound($3, @3, $5, @5); }
					| CODE_UNIT code_unit_scope '{' stmt_decls '}' 			{ $$ = vn->OnCodeUnit($4, @4); }

compound_scope	: %empty													{ $$ = make_shared<VN::CompoundScopeGnomon>(); 
																			  vn->AddGnomon($$); }

code_unit_scope	: %empty													{ $$ = make_shared<VN::CodeUnitScopeGnomon>(); 
																			  vn->AddGnomon($$); }

stmt_decls	: stmt_decl_l													{ $$ = $1; }
			| stmt_decl_l stmt_decls										{ $$ = $1 + $2; }

stmt_decl_l	: statement_l													
			| compound_entry												{ $$ = {$1}; } 
			| declaration													{ $$ = {$1}; } 

//////////////////////////////// DECLARATIONS ////////////////////////////////////         

decl_boot		: decl_entry								
				| decl_commands										{ $$ = vn->OnEmbeddedCommands($1); }

decl_commands	: decl_entry COMMAND_TERM commands					{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 

decl_entry		: decl_disjunction

decl_disjunction	: decl_conjunction
					| decl_disjunction DISJUNCTION_OP decl_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

decl_conjunction 	: open_declaration       
					| decl_conjunction CONJUNCTION_OP open_declaration  	{ $$ = vn->OnConjunction($1, $3); }
					| decl_conjunction CONJUNCTION_OP bare_statement    	{ $$ = vn->OnConjunction($1, $3); }
					| decl_conjunction CONJUNCTION_OP expr_entry	    	{ $$ = vn->OnConjunction($1, $3); }

open_declaration	: declaration
					| bare_declaration

declaration	: bare_declaration ';'									{ $$ = $1; }      
			| comp_decl_nvn		

// OnInstance() will still try to program the current access. But the new fn will override it with the parsed acess, and then try to update the current access
bare_declaration: bare_decl_nvn
				| decl_prefix
				
comp_decl_nvn	: prototype compound_entry							{ $$ = vn->ApplyInitialiser($1, @1, $2, @2); }	

bare_decl_nvn	: prototype
				| prototype bare_initialiser							{ $$ = vn->ApplyInitialiser($1, @1, $2, @2); } 
				| prototype ':' memb_inits bare_initialiser				{ $$ = vn->ApplyMemberInits($1, @1, $3, @3); 
																		  $$ = vn->ApplyInitialiser($$, @1, $4, @4); } 
				| inheritance_record
				| enum				
			
bare_initialiser: C_ASSIGN assign_init									{ $$ = $2; } 
				| DESIGNATED_COMPOUND								
				| DESIGNATED_NORMAL									
			
prototype		: type_for_declarator declarator						{ $$ = vn->OnDeclaratorDecl({}, $1, @1, $2, @2); }	
				| qualifiers type_for_declarator declarator				{ $$ = vn->OnDeclaratorDecl($1, $2, @2, $3, @3); } // eg const int a	
				| type_for_declarator qualifiers declarator				{ $$ = vn->OnDeclaratorDecl($2, $1, @1, $3, @3); } // eg int const a 	
				| qualifiers type_for_declarator qualifiers declarator	{ $$ = vn->OnDeclaratorDecl($1+$3, $2, @2, $4, @4); } 
				| XSTRUCTOR id_primary parameterisation					{ $$ = vn->OnConstructorDecl(@$, {}, $2, $3); }	
				| qualifiers XSTRUCTOR id_primary parameterisation		{ $$ = vn->OnConstructorDecl(@$, $1, $3, $4); }	// for virtual destructor but needs ~

assign_init		: expr_entry
				| '{' '}'             				  					{ $$ = vn->OnArrayInitialiser({}); } 
				| '{' comma_sep_expr_decl '}'      						{ $$ = vn->OnArrayInitialiser($2); }               

decl_prefix : decl_postfix
			| 						         GREEN_GRASS_OP decl_prefix	{ $$ = vn->OnGrass($2); }
			| 							      POINTER_IS_OP decl_prefix	{ $$ = vn->OnPointerIs($2); }
			| 							        NEGATION_OP decl_prefix	{ $$ = vn->OnNegation($2); }			
			// Allows ‽Member to actually get us into access/member column so can have access spec
			|            decl_prerestrict_op_named acc_memb_prefix	{ $$ = vn->OnRestrict($1->node, @1, $2, @2); }
			   			 
decl_postfix: decl_primary		   
	                                       
decl_primary: decl_vn_prim
			| '(' decl_boot ')'														{ $$ = $2; } 
						
decl_vn_prim: decl_full_explicit_start itemisation					{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
			| DELTA_COMPARE_OP decl_boot DELTA_REPLACE_OP decl_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); }
			| DESIGNATED_DECL     						  			
			| STAR_OP OPEN_VN decl_entry CLOSE_VN					{ $$ = vn->OnStar($3); }
			
decl_full_explicit_start 		: explicit_decl_node					{ $$ = vn->MakeScopeGnomonForNode($1); 
                                                                      vn->AddGnomon($$.gnomon); }
                                                                                  
decl_prerestrict_op_named 	: prerestrict_op_scope resolved_decl_node	{ $$ = make_shared<VN::PrerestrictScopeGnomon>($2); 
                                                                          vn->AddGnomon($$); }
                                                                          
memb_inits	: memb_inits ',' memb_init_boot								{ $$ = $1; $$.push_back($3); }
			| memb_init_boot												{ $$ = {$1}; }

memb_init_boot	: memb_init_entry

memb_init_entry	: memb_init_prefix
        
memb_init_prefix: memb_init_postfix
				| 						        GREEN_GRASS_OP memb_init_prefix	{ $$ = vn->OnGrass($2); }
				| 					               NEGATION_OP memb_init_prefix	{ $$ = vn->OnNegation($2); }
				|                      mi_prerestrict_op_named memb_init_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
				|  						        stuff_op_scope memb_init_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
				|    stuff_op_scope OPEN_VN memb_init_boot CLOSE_VN memb_init_prefix	{ $$ = vn->OnStuff($5, $3, VN::Limit()); }
				|  stuff_op_scope OPEN_VN stuff_depth CLOSE_VN memb_init_prefix	{ $$ = vn->OnStuff($5, nullptr, $3); }
        
memb_init_postfix	: memb_init_primary
					| memb_init_primary '(' stmt_boot ')'						{ $$ = vn->OnMemberInitialiser($1, @2, $3, @3); }

memb_init_primary	: '(' memb_init_boot ')'                          			{ $$ = $2; }
					| DELTA_COMPARE_OP memb_init_boot DELTA_REPLACE_OP memb_init_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); } 
					| mi_full_explicit_start itemisation						{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
					| DESIGNATED_NORMAL       				  			
					| mi_id_by_name_op_named OPEN_VN STRING_LITERAL CLOSE_VN	{ $$ = vn->OnIdByName($1, @1, $3, @3); } // ASCII_NAME could be format
					| mi_build_id_op_named OPEN_VN STRING_LITERAL VN_SEP CLOSE_VN	{ $$ = vn->OnBuildId($1, @1, $3, @3, VN::Item{}); }
					| mi_build_id_op_named OPEN_VN STRING_LITERAL VN_SEP item CLOSE_VN	{ $$ = vn->OnBuildId($1, @1, $3, @3, $5); }
					| mi_build_id_op_named OPEN_VN VN_SEP item CLOSE_VN 			{ $$ = vn->OnBuildId($1, @1, wstring(), @3, $4); }
					| mi_transform_op_named OPEN_VN unified_prefix CLOSE_VN		{ $$ = vn->OnTransform($1, @1, $3, @3); }
					| STAR_OP												{ $$ = vn->OnStar(nullptr); }
					| STAR_OP OPEN_VN memb_init_boot CLOSE_VN					{ $$ = vn->OnStar($3); }
					| ANY_NODE_OP											{ $$ = nullptr; }
                      
mi_full_explicit_start 	: explicit_mi_node							{ $$ = vn->MakeScopeGnomonForNode($1); 
																	  vn->AddGnomon($$.gnomon); }
mi_prerestrict_op_named	: prerestrict_op_scope resolved_mi_name		{ $$ = $2.node; (void)$1; }                      
mi_id_by_name_op_named 	: id_by_name_op_scope resolved_mi_name		{ $$ = $2.node; (void)$1; }
mi_build_id_op_named	: builder_id_op_scope resolved_mi_name		{ $$ = $2.node; (void)$1; }
mi_transform_op_named  	: transform_op_scope TRANSFORM_NAME_NORMAL	{ $$ = $2.as_ascii; (void)$1; }

//////////////////////////////// CONCRETE DECLARATORS /////////////////////////////////////         
                          		
declarator			: declarator_prefix									 

declarator_prefix	: declarator_postfix
					|                          '&' declarator_prefix { $$ = make_shared<Declarators::Reference>($2); } 
					|                          '*' declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals({}), $2); } 
					|               '*' qualifiers declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals($2), $3); } 

declarator_postfix	: declarator_primary
					| declarator_postfix parameterisation			{ $$ = make_shared<Declarators::Function>($1, $2, vn->OnCVQuals({})); }               
					| declarator_postfix parameterisation qualifiers{ $$ = make_shared<Declarators::Function>($1, $2, vn->OnCVQuals($3)); } 
					| declarator_postfix '[' stmt_entry ']'			{ $$ = make_shared<Declarators::Array>($1, $3); } 
                
declarator_primary	: id_primary  									{ $$ = make_shared<Declarators::Concrete>($1); }  
                    | '(' stmt_boot ')'								{ $$ = make_shared<Declarators::Concrete>($2); }
                     
//////////////////////////////// ABSTRACT DECLARATORS /////////////////////////////////////         
                          		
ab_declarator			: ab_declarator_prefix									 

ab_declarator_prefix	: ab_declarator_postfix
						|                          '&' ab_declarator_prefix { $$ = make_shared<Declarators::Reference>($2); } 
						|                          '*' ab_declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals({}), $2); } 
						|               '*' qualifiers ab_declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals($2), $3); } 
						|                      	      		 		 	'&' { $$ = make_shared<Declarators::Reference>(nullptr); }  
						|                           				 	'*' { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals({}), nullptr); } 
						|                          		  	 '*' qualifiers { $$ = make_shared<Declarators::Pointer>(vn->OnCVQuals($2), nullptr); } 

ab_declarator_postfix	: ab_declarator_postfix parameterisation			{ $$ = make_shared<Declarators::Function>($1, $2, vn->OnCVQuals({})); }          
ab_declarator_postfix	: ab_declarator_postfix parameterisation qualifiers	{ $$ = make_shared<Declarators::Function>($1, $2, vn->OnCVQuals($3)); }        
						| ab_declarator_postfix '[' stmt_entry ']'			{ $$ = make_shared<Declarators::Array>($1, $3); } 
						| parameterisation									{ $$ = make_shared<Declarators::Function>(nullptr, $1, vn->OnCVQuals({})); }   
						| parameterisation qualifiers						{ $$ = make_shared<Declarators::Function>(nullptr, $1, vn->OnCVQuals($2)); }   
						| '[' stmt_entry ']'									{ $$ = make_shared<Declarators::Array>(nullptr, $2); }                 		
					                         
//////////////////////////////////////// PARAMETERS /////////////////////////////////////////////

parameterisation	: params_scope parameters ')'				{ $$ = $2; }
					| params_scope ')'							{ $$.clear(); }							

params_scope	: '(' 											{ $$ = make_shared<VN::ParameterisationScopeGnomon>(); 
																  vn->AddGnomon($$); } 

parameters	: parameter												{ $$.push_back($1); }
			| parameters ',' parameter								{ $$ = $1; $$.push_back($3); }			
				
parameter   : decl_entry           									
                         
//////////////////////////////// CLASSES ////////////////////////////////////                                  
                         
inheritance_record	: irecord_scope '{' members '}'			 				{ $$ = vn->FinishRecord( @$, $1.node, {}, $3 ); }
					| irecord_scope ':' bases '{' members '}'				{ $$ = vn->FinishRecord( @$, $1.node, $3, $5 ); }
					| irecord_scope '{' '}'			 						{ $$ = vn->FinishRecord( @$, $1.node, {}, {} ); }
					| irecord_scope ':' bases '{' '}'						{ $$ = vn->FinishRecord( @$, $1.node, $3, {} ); }
             
irecord_scope   : irecord_node type_specified        						{ $$ = { vn->ApplyIdentifier($1, @2, $2), 
																		             vn->MakeRecordScopeGnomon($1, $2) }; 
																			  vn->AddGnomon($$.gnomon); } 
																			  
irecord_node	: IRECORD_KEYWORD											{ $$ = vn->StartRecord(@$, $1->GetKeyword(Syntax::Policy())); }
		 		| explicit_decl_node										{ $$ = $1; } 
                                                  
bases			: base_spec                                                 { $$.push_back($1); } 
				| bases ',' base_spec										{ $$ = $1; $$.push_back($3); } 
                                       
base_spec		: type_specified											{ $$ = vn->OnBase($1); } 
				| id_wildcard												{ $$ = $1; }
				| DESIGNATED_NORMAL       				  					// To match a designated Star
				| access_spec type_specified								{ $$ = vn->OnBase($1, $2, @$); }
                                                                                                                                                         
members			: member													{ $$.push_back($1); }
				| members member 											{ $$ = $1; $$.push_back($2); }

acc_memb_boot	: bare_member_nvn     
				| bare_member_nvn ';'	
				| comp_member
				| acc_memb_prefix

member			: bare_member ';'											{ $$ = $1; }      
				| comp_member
				
// access_clause: OnInstance() will still try to program the current access. But the new fn will override it with the parsed acess, and then try to update the current access
comp_member		: comp_decl_nvn		
				| access_clause comp_decl_nvn								{ $$ = vn->ApplyAccessSpec($2, @2, $1); }	
				
bare_member		: bare_member_nvn
				| acc_memb_prefix  

bare_member_nvn : bare_decl_nvn
				| access_clause bare_decl_nvn								{ $$ = vn->ApplyAccessSpec($2, @2, $1); } 

access_clause	: acc_memb_prefix ':'									

access_spec		: qualifier_node 

// Acc Memb column includes access specifiers and full member declarations. We combine both because
// a member can start with both, and the parser has limited lookahead. By being explicit, we avoid the 
// brittleness of symmetrical columns. This will make eg (int a) : char b; syntactical (i.e. if 
// legitimised by a VN or paren, a declaration could be used as an access specifier). TODO prevent in Actions.
acc_memb_prefix	: acc_memb_postfix
				| 						     GREEN_GRASS_OP acc_memb_prefix	{ $$ = vn->OnGrass($2); }
				| 						      POINTER_IS_OP acc_memb_prefix	{ $$ = vn->OnPointerIs($2); }
				| 					         	NEGATION_OP	acc_memb_prefix	{ $$ = vn->OnNegation($2); }
				|         	      decl_prerestrict_op_named acc_memb_prefix	{ $$ = vn->OnRestrict($1->node, @1, $2, @2); }
				|  						        stuff_op_scope unified_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
				| stuff_op_scope OPEN_VN unified_entry CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, $3, VN::Limit()); }
				|  stuff_op_scope OPEN_VN stuff_depth CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, nullptr, $3); }
				|                          BUILD_SIZE_OP unified_prefix { $$ = vn->OnBuildSize($2); }
				|                           STRINGIZE_OP unified_prefix { $$ = vn->OnStringize($2); }


acc_memb_postfix: acc_memb_paren     
		
acc_memb_paren	: acc_memb_primary
				| '(' acc_memb_boot ')'                          			{ $$ = $2; } 

acc_memb_primary: qualifier_node // Gets us the access specs 
				| DELTA_COMPARE_OP acc_memb_boot DELTA_REPLACE_OP acc_memb_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); }
				| decl_full_explicit_start itemisation					{ $$ = vn->FinishExplicitNode($1.node, @1, $2); } 
				| DESIGNATED_DECL       				  				
				| DESIGNATED_NORMAL       				  		
				| DESIGNATED_COMPOUND      				  			    // TODO want declarations and access specs
				| transform_op_named OPEN_VN unified_prefix CLOSE_VN	{ $$ = vn->OnTransform($1, @1, $3, @3); }
				| STAR_OP												{ $$ = vn->OnStar(nullptr); }
				| STAR_OP OPEN_VN acc_memb_boot CLOSE_VN				{ $$ = vn->OnStar($3); }
				| ANY_NODE_OP											{ $$ = nullptr; }

//////////////////////////////// ENUMERATIONS ////////////////////////////////////                                  
                         
enum			: enum_scope '{' enumerators '}'		 					{ $$ = vn->FinishRecord( @$, $1.node, {}, $3 ); }
				| enum_scope '{' '}'		 								{ $$ = vn->FinishRecord( @$, $1.node, {}, {} ); }
             
enum_scope      : enum_node type_specified       							{ $$ = { vn->ApplyIdentifier($1, @2, $2), 
																		             vn->MakeRecordScopeGnomon($1, $2) }; 
																			  vn->AddGnomon($$.gnomon); } 
																			  
enum_node		: ENUM_KEYWORD												{ $$ = vn->StartRecord(@$, $1->GetKeyword(Syntax::Policy())); }
//		 		| explicit_decl_node										{ $$ = $1; } // TODO bring back explicit support but differentiate
                                                                                                                                                       
enumerators		: enumerator												{ $$.push_back($1); }
				| enumerators ',' enumerator 								{ $$ = $1; $$.push_back($3); }

// TODO Eventually to resemble the cyclic structure of declarations
enumerator		: prototype_enumerator
				| prototype_enumerator C_ASSIGN assign_init					{ $$ = vn->ApplyInitialiser($1, @1, $3, @3); } 
				| DESIGNATED_DECL			 							

prototype_enumerator 		: id_primary 									{ $$ = vn->OnEnumerator(@1, $1); }

//////////////////////////////// STATEMENTS ////////////////////////////////////                 

stmt_entry			: stmt_disjunction

stmt_disjunction	: stmt_conjunction
					| stmt_disjunction DISJUNCTION_OP stmt_conjunction		{ $$ = vn->OnDisjunction($1, $3); }
					| stmt_disjunction DISJUNCTION_OP decl_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

stmt_conjunction 	: open_statement       
					| stmt_conjunction CONJUNCTION_OP open_statement   		{ $$ = vn->OnConjunction($1, $3); }
					| stmt_conjunction CONJUNCTION_OP open_declaration 		{ $$ = vn->OnConjunction($1, $3); }
		
open_statement    	: open_statement_nc		
					| compound_entry
										
stmt_entry_nc		: stmt_disjunction_nc

stmt_disjunction_nc	: stmt_conjunction_nc
					| stmt_disjunction_nc DISJUNCTION_OP stmt_conjunction_nc		{ $$ = vn->OnDisjunction($1, $3); }
					| stmt_disjunction_nc DISJUNCTION_OP decl_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

stmt_conjunction_nc : open_statement_nc       
					| stmt_conjunction_nc CONJUNCTION_OP open_statement_nc   		{ $$ = vn->OnConjunction($1, $3); }
					| stmt_conjunction_nc CONJUNCTION_OP open_declaration 		{ $$ = vn->OnConjunction($1, $3); }
		
open_statement_nc 	: expr_entry
					| statement		
					
stmt_comp	: statement_l													{ $$ = vn->OnNeedSoloStatement($1, @1); }
			| compound_entry	
			
statement	: statement_l													{ $$ = vn->OnNeedSoloStatement($1, @1); }

statement_l : statement_e									
			| ';'															{ $$ = { vn->OnNop(@1) }; }      

// Putting arrivals on compound or expr_entry causes conflicts
statement_e : statement_nc %prec ';'											

statement_nc: statement_nl													{ $$ = {$1}; }
			| arrival statement_nl											{ $$ = {$1, $2}; } 
			| arrival ';'		 											{ $$ = {$1}; } // Note no Nop

arrival		: CASE_KEYWORD expr_entry ':'									{ $$ = vn->OnCase($2, @2); } 
			| CASE_KEYWORD expr_entry RANGE_OP expr_entry ':' 				{ $$ = vn->OnRangeCase($2, @2, $4, @4); } // TODO we'll be given the Case node and must let it evolve into RangeCase
			| DEFAULT_KEYWORD ':'											{ $$ = vn->OnDefault(@$); } 
			| expr_prefix ':' 			 									{ $$ = vn->OnLabel($1, @1); } 

statement_nl: bare_statement ';'											{ $$ = $1; }      
			| expr_entry ';'												{ $$ = $1; } // TODO Should come in under bare_statement but conflicts
// #899		| explicit_norm_node '(' semicolon_args ')' stmt_comp			{ $$ = vn->OnArgsBodyStmt($1, @1, $3, @3, $5, @5); }
			| KEYWORD_ARGS_BODY_STMT '(' semicolon_args ')' stmt_comp		{ $$ = vn->OnArgsBodyStmt($1->GetKeyword(Syntax::Policy()), @1, $3, @3, $5, @5); }
			| WHILE_KEYWORD '(' stmt_boot ')' stmt_comp 					{ $$ = vn->OnWhile($3, @3, $5, @5); }
			| KEYWORD_ARGS_BODY_WITH_ELSE '(' semicolon_args ')' stmt_comp	
			  %prec KEYWORD_ARGS_BODY_WITH_ELSE								{ $$ = vn->OnArgsBodyWithElseStmt($1->GetKeyword(Syntax::Policy()), @1, $3, @3, $5, @5, @1, nullptr, @1); }
			| KEYWORD_ARGS_BODY_WITH_ELSE '(' semicolon_args ')' stmt_comp
			  ELSE_KEYWORD stmt_comp										{ $$ = vn->OnArgsBodyWithElseStmt($1->GetKeyword(Syntax::Policy()), @1, $3, @3, $5, @5, @6, $7, @7); }

bare_statement	: KEYWORD_SIMPLE_STMT										{ $$ = $1; }
				| KEYWORD_SPACE_SEP_STMT expr_entry							{ $$ = vn->OnSpaceSepStmt($1->GetKeyword(Syntax::Policy()), @1, $2, @2); }
				| DO_KEYWORD stmt_comp WHILE_KEYWORD '(' stmt_boot ')' 		{ $$ = vn->OnDo($2, @2, $5, @5); } // TODO a While node is gobbled up here

semicolon_args	: expr_entry										{ $$.push_back($1); }
				| semicolon_args ';' expr_entry						{ $$ = $1; $$.push_back($3); }

//////////////////////////////// EXPRESSIONS ////////////////////////////////////         

expr_entry			: expr_comma_op
                                   
expr_comma_op       : expr_no_comma_op
// Operator comma removed due to ambiguity with ∧ and ∨. Comma is lower in the case of eg parameters but higher here.
//                    | expr_comma_op ',' expr_no_comma_op						{ $$ = vn->OnInfixOperator(",", $1, $3); }  
                    
expr_no_comma_op 	: expr_id_value

expr_id_value		: expr_assignment
					| expr_id_value MAP_ARG_OP expr_assignment					{ $$ = vn->OnIdValuePair($1, @1, $3); }
					
expr_assignment 	: expr_logical_or 
					| 				   expr_logical_or C_ASSIGN expr_assignment	{ $$ = vn->OnInfixOperator($2, $1, $3); }
					|         expr_logical_or C_COMPOUND_ASSIGN expr_assignment	{ $$ = vn->OnInfixOperator($2, $1, $3); }
					|   	 expr_logical_or '?' expr_entry ':' expr_assignment	{ $$ = vn->OnConditionalOperator($1, $3, $5); }

expr_logical_or 	: expr_logical_and
					| expr_logical_or C_LOGICAL_OR_OP expr_logical_and			{ $$ = vn->OnInfixOperator($2, $1, $3); }
		
expr_logical_and	: expr_bitwise_or
					| expr_logical_and C_LOGICAL_AND_OP expr_bitwise_or			{ $$ = vn->OnInfixOperator($2, $1, $3); }

expr_bitwise_or 	: expr_bitwise_xor
					| expr_bitwise_or C_BITWISE_OR_OP expr_bitwise_xor			{ $$ = vn->OnInfixOperator($2, $1, $3); }
		
expr_bitwise_xor	: expr_bitwise_and
					| expr_bitwise_xor C_BITWISE_XOR_OP expr_bitwise_and		{ $$ = vn->OnInfixOperator($2, $1, $3); }
		
expr_bitwise_and	: expr_equality
					| expr_bitwise_and '&' expr_equality						{ $$ = vn->OnInfixOperator("&", $1, $3); }

expr_equality 		: expr_relational
					| expr_equality C_EQUALITY_OP expr_relational				{ $$ = vn->OnInfixOperator($2, $1, $3); }

expr_relational 	: expr_shift
					| expr_relational C_RELATIONAL_OP expr_shift				{ $$ = vn->OnInfixOperator($2, $1, $3); }

expr_shift			: expr_add_etc
					| expr_shift C_SHIFT_OP expr_add_etc						{ $$ = vn->OnInfixOperator($2, $1, $3); }
		
expr_add_etc 		: expr_mul_etc
					| expr_add_etc C_ADD_SUB_OP expr_mul_etc					{ $$ = vn->OnInfixOperator($2, $1, $3); }
		
expr_mul_etc 		: expr_prefix
					| expr_mul_etc C_DIV_MOD_OP expr_prefix						{ $$ = vn->OnInfixOperator($2, $1, $3); }
					| expr_mul_etc '*' expr_prefix								{ $$ = vn->OnInfixOperator("*", $1, $3); }
		
expr_prefix : expr_postfix
			| 					            C_PREFIX_OP	expr_prefix	{ $$ = vn->OnPrefixOperator($1, $2); }
			| 					                    '&' expr_prefix	{ $$ = vn->OnPrefixOperator("&", $2); }
			| 					                    '*' expr_prefix	{ $$ = vn->OnPrefixOperator("*", $2); }
			| 					           C_ADD_SUB_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1, $2); }
			| 					      C_PRE_OR_INFIX_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1, $2); }
			| 					    C_PRE_OR_POSTFIX_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1, $2); }
			| 						     GREEN_GRASS_OP expr_prefix	{ $$ = vn->OnGrass($2); }
			| 						      POINTER_IS_OP expr_prefix	{ $$ = vn->OnPointerIs($2); }
			| 					         	NEGATION_OP	expr_prefix	{ $$ = vn->OnNegation($2); }
			|                      prerestrict_op_named expr_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|              mi_prerestrict_op_named memb_init_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|  						        stuff_op_scope unified_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
			| stuff_op_scope OPEN_VN unified_entry CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, $3, VN::Limit()); }
			|  stuff_op_scope OPEN_VN stuff_depth CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, nullptr, $3); }
			|                          BUILD_SIZE_OP unified_prefix { $$ = vn->OnBuildSize($2); }
			|                           STRINGIZE_OP unified_prefix { $$ = vn->OnStringize($2); }

// This one dips into ASCII/C because VN doesn't otherwise need equality/inequality operators
stuff_depth		: C_ASSIGN INTEGRAL_LITERAL					{ $$ = VN::Limit{ $1, @1, $2, @2 }; }

expr_postfix: expr_primary     
			| expr_postfix C_PRE_OR_POSTFIX_OP 				 		{ $$ = vn->OnPostfixOperator($2, $1); }
			| expr_postfix '[' stmt_entry ']'	 					{ $$ = vn->OnSubscript($1, $3); }
			| expr_postfix OPEN_MAP_CALL comma_sep_expr_decl CLOSE_MAP_CALL	{ $$ = vn->OnMapArgsCall($1, $3); }
			| expr_postfix OPEN_MAP_CALL CLOSE_MAP_CALL				{ $$ = vn->OnMapArgsCall($1, list<TreePtr<Node>>()); }
			| expr_postfix '(' comma_sep_expr_decl ')'				{ $$ = vn->OnSeqArgsCall($1, $3); }
			| expr_postfix '(' ')'	 								{ $$ = vn->OnSeqArgsCall($1, list<TreePtr<Node>>()); }
			| expr_postfix '.' expr_primary							{ $$ = vn->OnLookup($1, $3, @3); }
		
expr_primary: id_primary  
			| '(' stmt_boot ')'                          		{ $$ = $2; }
			| INTEGRAL_LITERAL					      			{ $$ = vn->OnIntegralLiteral($1, @1); }
			| STRING_LITERAL					      			{ $$ = vn->OnStringLiteral($1); }
			| BOOL_LITERAL									
			| KEYWORD_PRIMARY_OP							
			| FUNC_ON_TYPE '(' type_boot ')'       				{ $$ = vn->OnFuncOnType($1->GetKeyword(Syntax::Policy()), @1, $3, @3); }			
			| DESIGNATED_COMPOUND      				  			// TODO move up into the statement rules once we don't need to support eg int main() = my_compound

id_primary  : id_wildcard
			| DELTA_COMPARE_OP stmt_boot DELTA_REPLACE_OP stmt_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); }
			| norm_full_explicit_start itemisation					{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
			| DESIGNATED_NORMAL       				  			
			| id_by_name_op_named OPEN_VN STRING_LITERAL CLOSE_VN	{ $$ = vn->OnIdByName($1, @1, $3, @3); } // ASCII_NAME could be format
			| build_id_named OPEN_VN STRING_LITERAL VN_SEP CLOSE_VN { $$ = vn->OnBuildId($1, @1, $3, @3, VN::Item{}); }
			| build_id_named OPEN_VN STRING_LITERAL VN_SEP item CLOSE_VN	{ $$ = vn->OnBuildId($1, @1, $3, @3, $5); }
			| build_id_named OPEN_VN VN_SEP item CLOSE_VN 			{ $$ = vn->OnBuildId($1, @1, wstring(), @3, $4); }
			| transform_op_named OPEN_VN unified_prefix CLOSE_VN	{ $$ = vn->OnTransform($1, @1, $3, @3); }

id_wildcard : STAR_OP												{ $$ = vn->OnStar(nullptr); }
			| STAR_OP OPEN_VN stmt_entry CLOSE_VN					{ $$ = vn->OnStar($3); }
			| ANY_NODE_OP											{ $$ = nullptr; }

comma_sep_expr_decl	: expr_no_comma_op								{ $$.push_back($1); }
					| comma_sep_expr_decl ',' expr_no_comma_op		{ $$ = $1; $$.push_back($3); }			

norm_full_explicit_start : explicit_norm_node						{ $$ = vn->MakeScopeGnomonForNode($1); 
																	  vn->AddGnomon($$.gnomon); }
																
prerestrict_op_named: prerestrict_op_scope resolved_norm_name	{ $$ = $2.node; (void)$1; }
id_by_name_op_named : id_by_name_op_scope resolved_norm_name		{ $$ = $2.node; (void)$1; }
build_id_named 		: builder_id_op_scope resolved_norm_name		{ $$ = $2.node; (void)$1; }
transform_op_named  : transform_op_scope TRANSFORM_NAME_NORMAL { $$ = $2.as_ascii; (void)$1; }

//////////////////////////////// TYPE-ID ////////////////////////////////////         
// type-id as seen in https://alx71hub.github.io/hcb/#type-id can be troublesome grammatically. Care advised.

type_id 			: ab_type
                      
ab_type				: type_for_declarator ab_declarator 				 		{ $$ = vn->OnAbDeclType(@$, {}, $1, $2); }
ab_type				: qualifiers type_for_declarator ab_declarator 		 		{ $$ = vn->OnAbDeclType(@$, $1, $2, $3); }  
ab_type				: type_for_declarator qualifiers ab_declarator 		 		{ $$ = vn->OnAbDeclType(@$, $2, $1, $3); } 
ab_type				: qualifiers type_for_declarator qualifiers ab_declarator	{ $$ = vn->OnAbDeclType(@$, $1+$3, $2, $4); } 
					| type_for_declarator 				 						// abstract declarators can be "invisible"
					| XSTRUCTOR parameterisation 								{ $$ = vn->OnConstructorType($2); } 				                     

//////////////////////////////// TYPES ////////////////////////////////////         
       
type_boot 			: type_entry

type_entry			: type_disjunction

type_disjunction	: type_conjunction
					| type_disjunction DISJUNCTION_OP type_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

type_conjunction 	: type_specified
					| type_conjunction CONJUNCTION_OP type_specified		{ $$ = vn->OnConjunction($1, $3); }
                    										 								 			               
// Not including types that require declarators (except via built-in, designation etc)          
type_specified		: type_prefix          
          
type_prefix : type_postfix
			| 						         GREEN_GRASS_OP type_prefix	{ $$ = vn->OnGrass($2); }
			| 							      POINTER_IS_OP type_prefix	{ $$ = vn->OnPointerIs($2); }
			| 							        NEGATION_OP type_prefix	{ $$ = vn->OnNegation($2); }
			|                     type_prerestrict_op_named type_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|								 TYPE_INDICATOR expr_prefix { $$ = $2; }

type_postfix: type_primary		   
			      
// prevent typeised postfix expressions looking like declarators eg ⍑x[2] typeizes x[2] and you need (⍑x) [2] for an abstract type
type_for_declarator : type_primary						 			                			      
			                                       
type_primary: type_vn_prim
			| '(' type_boot ')'													{ $$ = $2; } // For disambiguation and introducing types using anonymous declarators
            | TYPE_KEYWORD														
			| type_specifier_seq 												{ $$ = vn->OnTypeSpecifierSeq($1, @1); }				
			| TYPE_INDICATOR TYPE_INDICATOR '(' type_id ')'						{ $$ = $4; } // See #888
			
type_vn_prim: type_full_explicit_start itemisation								 { $$ = vn->FinishExplicitNode($1.node, @1, $2); }
			| DELTA_COMPARE_OP type_boot DELTA_REPLACE_OP type_boot DELTA_END_OP { $$ = vn->OnDelta($2, $4); }
			| DESIGNATED_TYPE     									  			
			| type_id_by_name_op_named OPEN_VN STRING_LITERAL CLOSE_VN			 { $$ = vn->OnIdByName($1, @1, $3, @3); } // ASCII_NAME could be format
			| type_build_id_op_named OPEN_VN STRING_LITERAL VN_SEP CLOSE_VN 	 { $$ = vn->OnBuildId($1, @1, $3, @3, VN::Item{}); }
			| type_build_id_op_named OPEN_VN STRING_LITERAL VN_SEP item CLOSE_VN { $$ = vn->OnBuildId($1, @1, $3, @3, $5); }
			| type_build_id_op_named OPEN_VN VN_SEP item CLOSE_VN 				 { $$ = vn->OnBuildId($1, @1, wstring(), @3, $4); }
			| type_transform_op_named OPEN_VN unified_prefix CLOSE_VN 			 { $$ = vn->OnTransform($1, @1, $3, @3); }
			| TYPE_INDICATOR STAR_OP OPEN_VN type_boot CLOSE_VN					 { $$ = vn->OnStar($4); }
			| STAR_OP OPEN_VN type_boot CLOSE_VN								 { $$ = vn->OnStar($3); }
		 	
type_full_explicit_start 	: explicit_type_node								{ $$ = vn->MakeScopeGnomonForNode($1); 
                                                                                  vn->AddGnomon($$.gnomon); }
type_prerestrict_op_named 	: prerestrict_op_scope resolved_type_name			{ $$ = $2.node; (void)$1; }
type_id_by_name_op_named 	: id_by_name_op_scope resolved_type_name			{ $$ = $2.node; (void)$1; }
type_build_id_op_named 		: builder_id_op_scope resolved_type_name			{ $$ = $2.node; (void)$1; }
type_transform_op_named 	: transform_op_scope TRANSFORM_NAME_TYPE 			{ $$ = $2.as_ascii; (void)$1; }

// eg "long unsigned int". VN represents this as a single node. We don't want nodes for its constituent parts.
// So, this is the level at which we mix in the VN syntax.
type_specifier_seq	: TYPE_SPECIFIER											{ $$.insert($1); }
					| TYPE_SPECIFIER type_specifier_seq							{ $$ = $2; $$.insert($1); }
                    | TYPE_KEYWORD type_specifier_seq							{ $$ = $2; $$.insert($1->GetKeyword(Syntax::Policy())); }
                    
//////////////////////////////// QUALIFIERS ////////////////////////////////////         

qualifiers		: qualifier													{ $$.push_back($1); }
				| qualifiers qualifier										{ $$ = $1; $$.push_back($2); }			

qualifier		: qualifier_nw
				
// No wildcards version
qualifier_nw	: qualifier_node											{ $$ = VN::QualifierData($$, VN::QualCat::NODE, $1); }
				| STATIC_KEYWORD											{ $$ = VN::QualifierData($$, VN::QualCat::STATIC); }
				| TYPEDEF_KEYWORD											{ $$ = VN::QualifierData($$, VN::QualCat::TYPEDEF); }

qualifier_node	: qual_full_explicit_start itemisation						{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
				| QUAL_NODE_KEYWORD								
				| DESIGNATED_QUAL       				  			

qual_full_explicit_start : explicit_qual_node								{ $$ = vn->MakeScopeGnomonForNode($1); 
                                                                              vn->AddGnomon($$.gnomon); }

//////////////////////////////////////// RECOGNISER GLUE /////////////////////////////////////////////
// 2 things going on here:
// - Recogniser can only supply one token, but we can "or" them together using rules.
// - We create Gnomons and give them to the recogniser - their lifetime indicates scopes.

vn_name		: UNICODE_NAME    							{ $$ = $1.as_unicode; }
			| ASCII_NAME								{ $$ = $1.as_unicode; }     
          
// RESOLVED_X is strong i.e. there was definitely a ::. resolved_x is weak and
// doesn't require this. See comment by part_resolve for why we don't need a value from 
// part_resolve. The Gnomon is still around because we *could* use $1 here, so it must be valid.

explicit_norm_node	: explicit_op_scope resolved_norm_node	{ $$ = $2; }

resolved_norm_node	: resolved_norm_name					{ $$ = $1.node; }

resolved_norm_name	: part_resolve RESOLVED_NORMAL			{ $$ = $2; }
					| RESOLVED_NORMAL					

explicit_type_node	: explicit_op_scope resolved_type_node	{ $$ = $2; }

resolved_type_node	: resolved_type_name					{ $$ = $1.node; }

resolved_type_name	: part_resolve RESOLVED_TYPE			{ $$ = $2; }
					| RESOLVED_TYPE						
	
explicit_decl_node	: explicit_op_scope resolved_decl_node	{ $$ = $2; }

resolved_decl_node	: resolved_decl_name					{ $$ = $1.node; }

resolved_decl_name	: part_resolve RESOLVED_DECL 			{ $$ = $2; }
					| RESOLVED_DECL							

explicit_qual_node	: explicit_op_scope resolved_qual_node	{ $$ = $2; }

resolved_qual_node	: resolved_qual_name					{ $$ = $1.node; }

resolved_qual_name	: part_resolve RESOLVED_QUAL		{ $$ = $2; }
					| RESOLVED_QUAL						

explicit_mi_node	: explicit_op_scope resolved_mi_node	{ $$ = $2; }

resolved_mi_node	: resolved_mi_name					{ $$ = $1.node; }

resolved_mi_name	: part_resolve RESOLVED_MEMB_INIT	{ $$ = $2; }
					| RESOLVED_MEMB_INIT				

// On sight of ::, we inform the recognition layer, which returns a shared_ptr which will 
// expire when the production is complete or an error forces unwind. The naming layer
// keeps weak_ptrs to these and will send us RESOLVED_NORMAL if one exists.
part_resolve	: node_namespace RESOLUTION_OP			{ $$ = make_shared<VN::ResolverGnomon>($1.as_andata_block);
                                                          recogniser->AddGnomon($$); }
    
node_namespace 	: part_resolve NODE_NAMESPACE			{ $$ = $2; }
				| NODE_NAMESPACE						{ $$ = $1; }				      


explicit_op_scope		: EXPLICIT_OP 		{ $$ = make_shared<VN::NodeNameScopeGnomon>(); 
										      recogniser->AddGnomon($$); }
										      
prerestrict_op_scope	: PRERESTRICT_OP	{ $$ = make_shared<VN::NodeNameScopeGnomon>(); 
										      recogniser->AddGnomon($$); }

id_by_name_op_scope		: ID_BY_NAME_OP 	{ $$ = make_shared<VN::NodeNameScopeGnomon>(); 
											  recogniser->AddGnomon($$); }

builder_id_op_scope		: BUILDER_ID_OP 	{ $$ = make_shared<VN::NodeNameScopeGnomon>(); 
											  recogniser->AddGnomon($$); }

transform_op_scope		: TRANSFORM_OP		{ $$ = make_shared<VN::TransformNameScopeGnomon>(); 
											  recogniser->AddGnomon($$); }

stuff_op_scope			: STUFF_OP			{ $$ = make_shared<VN::UnknownScopeGnomon>("stuff pattern"); 
											  vn->AddGnomon($$); }

%%
