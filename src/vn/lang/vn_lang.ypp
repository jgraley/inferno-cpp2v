%require "3.2"

%language "c++"
%define api.namespace {YY}
%define api.parser.class {VNLangParser}
%define api.value.type variant
%define api.token.constructor
%define parse.error detailed
// Inadequacy Elimination LR
%define lr.type ielr
// Lookahead Correction
%define parse.lac full
%define parse.trace

%defines

%locations
%define api.location.file "vn_lang.location.hpp"

%code requires {
  // Appears high-ish in the generated .hpp file
  // Use full paths because we can be included from elsewhere and build/src/x is not "near" src/x
  
  #include <string>
  #include "vn/lang/vn_types.hpp"     
  #include "node/tree_ptr.hpp"

  struct ANDBlock;

  namespace YY {
    class VNLangScanner;      	
  };
  
  namespace VN { 
    // Things we point to from semantic values
    class Command;
    class Gnomon;
    // Infrastructure
    class VNLangActions;
	class VNLangRecogniser;
  }
}

%code { 
	// Appears high-ish in the generated .cpp file
	#include "vn_lang.lpp.hpp"  /* Generated by reflex. */
	#include "vn_commands.hpp"
	#include "vn_actions.hpp"     
	#include "declarators.hpp" 
	#include "tree/node_names.hpp"  
	#include "tree/cpptree.hpp" 
	#include "vn/agents/standard_agent.hpp"  
	#include "vn_recogniser.hpp"
	#include <iostream>
	#include <fstream>  

	#undef yylex
	#define yylex lexer.lex  /* Within bison's parse() we should invoke lexer.lex(), not the global yylex() */

	// Strings that could be translated have _() around them. 
	// See https://www.gnu.org/software/gettext/manual/gettext.html
	#define _(String) (String)
	#define N_(String) String 
}

%parse-param { YY::VNLangScanner& lexer }
%parse-param { VN::VNLangActions *vn }
%parse-param { VN::VNLangRecogniser *recogniser }

%define api.token.prefix {TOK_}

%token
	DESIGNATE_COMMAND 					        _("⪮")
	ENGINE_COMMAND	 						    _("꩜")
	ATTRIBUTE_COMMAND						    _("‡")
	COMMAND_TERM 						        _("⨟")
	OPEN_VN 							        _("⦅")
	CLOSE_VN 							        _("⦆")
	VN_SEP 								        _("⚬")
	VN_SUB_SEP							        _("🞄")
	OPEN_MAP_CALL						        _("〔")
	CLOSE_MAP_CALL						        _("〕")	
	MAP_ARG_OP 							        _("⦂")
	STUFF_OP		 					        _("⩨")
	DELTA_COMPARE_OP 					        _("▲")
	DELTA_REPLACE_OP 					        _("⯈")
	DELTA_END_OP 					 	        _("⯇")
	ANY_NODE_IN_RECORD 					        _("☆ in record") // allowed to be an access spec
	ANY_NODE_IN_COMPOUND				        _("☆ in compound") // allowed to be a label
	ANY_NODE_IN_OTHER					        _("☆ in other")
	STAR_IN_RECORD 						        _("★ in record") 
	STAR_IN_COMPOUND					        _("★ in compound")
	STAR_IN_OTHER 							    _("★ in other")
	TRANSFORM_OP						        _("⤨")
	NEGATION_OP							        _("¬")
	CONJUNCTION_OP						        _("∧")
	DISJUNCTION_OP						        _("∨")
	GREEN_GRASS_OP						        _("⫴")
	POINTER_IS_OP							    _("⮎")
	BUILD_SIZE_OP							    _("🄽")
	STRINGIZE_OP							    _("§")
	PRERESTRICT_OP						        _("‽")
	TYPE_INDICATOR						        _("⍑")
	CODE_UNIT 							        _("∞")
	RESOLUTION_OP 						        _("::")
	RANGE_OP 							        _("..")
    STATIC_KEYWORD								
	TYPENAME_KEYWORD						    
	ELSE_KEYWORD					 			// eg else
		
<string>	C_ASSIGN				        _("=")
<string>	C_ASSIGNMENT_OP					_("assignment operator")
<string>	C_LOGICAL_OR_OP			        _("||")		
<string>	C_LOGICAL_AND_OP		        _("&&")
<string>	C_BITWISE_OR_OP			        _("|")
<string>	C_BITWISE_XOR_OP		        _("^")
<string>	C_EQUALITY_OP					_("==")
<string>  	C_RELATIONAL_OP					_("relational operator")
<string>	C_SHIFT_OP						_("shift operator")
<string>	C_ADD_SUB_OP					_("add/subtract operator")
<string>    C_DIV_MOD_OP					_("divide/modulo operator")
<string>  	C_PREFIX_OP						_("prefix operator")
<string>	C_PRE_OR_INFIX_OP				_("prefix/infix operator")
<string>    C_PRE_OR_POSTFIX_OP 			_("prefix/postfix operator")
<wstring> 	STRING_LITERAL 					_("string literal")
<string> 	INTEGRAL_LITERAL				_("integer literal")
<string>	ASCII_FORMAT 					_("format string")
<string>	TYPE_SPECIFIER					_("simple type specifier")
<string>    TRANSFORM_NAME_TYPE				_("type transform")
<string>    TRANSFORM_NAME_NORMAL			_("normal transform")
<string>    NEW_ASCII_NAME 					_("ASCII name")
<wstring>   NEW_UNICODE_NAME 				_("Unicode name")
<const ANDBlock *>	NODE_NAMESPACE			_("scope resolving name")
<TreePtr<Node>>	DESIGNATED_NORMAL		_("designated statement")
<TreePtr<Node>>	DESIGNATED_TYPE			_("designated type")
<TreePtr<Node>>	DESIGNATED_CURRENT_RECORD_ID _("current record")
<TreePtr<Node>>	DESIGNATED_QUAL			_("designated qualifier")
<TreePtr<Node>>	DESIGNATED_ACCESS		_("designated access spec")
<TreePtr<Node>>	DESIGNATED_COMPOUND		_("designated compound") // DELETE ME
<TreePtr<Node>>	EXPLICIT_NORMAL			_("explicit statement/expression node name")
<TreePtr<Node>>	EXPLICIT_TYPE			_("explicit type node")
<TreePtr<Node>>	EXPLICIT_DECL			_("explicit declaration node")
<TreePtr<Node>>	EXPLICIT_QUAL			_("explicit qualifier node")
<TreePtr<Node>>	EXPLICIT_MEMB_INIT		_("explicit member initialiser node name")
<TreePtr<Node>>	PRERESTRICT_NORMAL		_("statement/expression pre-restriction")
<TreePtr<Node>>	PRERESTRICT_TYPE		_("type pre-restriction")
<TreePtr<Node>>	PRERESTRICT_DECL		_("declaration pre-restriction")
<TreePtr<Node>>	PRERESTRICT_QUAL		_("qualifier pre-restriction")
<TreePtr<Node>>	PRERESTRICT_MEMB_INIT	_("member init pre-restriction")
<TreePtr<Node>>	ID_BY_NAME_NORMAL		_("instance identifier by name")
<TreePtr<Node>>	ID_BY_NAME_TYPE			_("type identifier by name")
<TreePtr<Node>>	ID_BUILDER_NORMAL		_("instance identifier builder")
<TreePtr<Node>>	ID_BUILDER_TYPE			_("type identifier builder")
<TreePtr<Node>>	BOOL_LITERAL			_("boolean literal")
<TreePtr<Node>> KEYWORD_PRIMARY_OP		_("normal operator")
<TreePtr<Node>> KEYWORD_SIMPLE_STMT     _("simple statement") // eg break;
<TreePtr<Node>> KEYWORD_CONTROL_STMT 	_("args-and-body statement") // eg switch(args) body
<TreePtr<Node>> DO_KEYWORD				_("do")
<TreePtr<Node>> WHILE_KEYWORD			_("while")
<TreePtr<Node>> ARRIVAL_KEYWORD			_("arrival")
<TreePtr<Node>> LIBRARY_FUNC			_("library function") // Not necessarily C/C++
<TreePtr<Node>> LIBRARY_METHOD			_("library method") // Not necessarily C/C++
<TreePtr<Node>> FUNC_ON_TYPE			_("function on type")
<TreePtr<Node>> RECORD_KEYWORD			_("record")
<TreePtr<Node>> ENUM_KEYWORD			_("enum")
<TreePtr<Node>> QUAL_NODE_KEYWORD		_("qualifier")
<TreePtr<Node>> ACC_NODE_KEYWORD		_("access spec")
<TreePtr<Node>> TYPEDEF_KEYWORD			_("typedef")
<TreePtr<Node>> TYPE_SIGN				_("type signifier")
<TreePtr<Node>> TYPE_W_PARAMS_SIGN		_("type with arguments")
<TreePtr<Node>> COMPOUND_SIGN			_("compound") // not really C/C++
<TreePtr<Node>> RESOURCE_SIGN			_("resource") // unifies functions and cons/destructors
<TreePtr<Node>> NORMAL_ID_SIGN			_("identifier") 
<TreePtr<Node>> PREPROCESSOR_ID_SIGN	_("preprocessor identifier") 
<TreePtr<Node>> INIT_SIGN				_("initialiser") 

stmt_low 
stmt_high
	
//%type <int>		 					star any_node 
%type <TreePtr<Node>> 				norm_boot norm_clause normal_disj normal_conj normal 
%type <TreePtr<Node>> 				vn_primary vn_wildcard
%type <TreePtr<Node>> 				expr_primary expr_postfix expr_prefix expr_relational 
%type <TreePtr<Node>> 				expr_assignment expr_equality expr_add_etc expr_logical_or expr_logical_and 
%type <TreePtr<Node>> 				expr_mul_etc expr_shift expr_bitwise_and expr_bitwise_or expr_bitwise_xor  
%type <TreePtr<Node>> 				expr_comma_op expr_no_comma_op expression expr_id_value 
%type <TreePtr<Node>> 				expr_clause expr_conjunction expr_disjunction expr_boot 
%type <TreePtr<Node>> 				id_primary id_boot id_disjunction id_conjunction id_prefix id_parens id_extras
%type <TreePtr<Node>> 				norm_primary 
%type <TreePtr<Node>> 			    access_wildcard access_primary 
%type <TreePtr<Node>> 				label_wildcard other_wildcard star_arg
%type <TreePtr<Node>> 				argumentation
%type <TreePtr<Node>> 				type_specified type_primary type_postfix type_prefix type_vn_prim 
%type <TreePtr<Node>> 				type_disjunction type_conjunction
%type <TreePtr<Node>> 				unified_boot unified_clause unified_prefix 
%type <TreePtr<Node>> 				arrival
%type <TreePtr<Node>> 				stmt_decl bare_statement statement_nca statement control_stmt_sign       
%type <TreePtr<Node>>   			statement_nc 
%type <TreePtr<Node>> 				declaration 
%type <TreePtr<Node>> 				prototype bare_declaration bare_initialiser comp_declaration
%type <TreePtr<Node>> 				assign_init
%type <TreePtr<Node>> 				compound_primary parameter type_boot type_clause compound_prefix compound 
//%type <TreePtr<Node>> 			compound_commands compound_boot
%type <TreePtr<Node>> 				type_for_declarator 
%type <TreePtr<Node>> 				declarator declarator_prefix declarator_postfix declarator_primary
%type <TreePtr<Node>> 				st_declarator st_declarator_prefix st_declarator_postfix st_declarator_primary
%type <TreePtr<Node>> 				type_id 
%type <TreePtr<Node>> 				ab_type ab_declarator ab_declarator_prefix ab_declarator_postfix 
%type <TreePtr<Node>> 				record base_spec bare_access access qualifier_node
%type <TreePtr<Node>> 				enum_node enum
%type <TreePtr<Node>>				memb_init_boot memb_init memb_init_prefix memb_init_postfix memb_init_primary
%type <wstring> 					new_vn_name
%type <list<shared_ptr<VN::Command>>>	commands sep_commands  
%type <list<shared_ptr<VN::Command>>>	expr_commands unified_commands norm_commands
%type <shared_ptr<VN::Command>>		script_command 
%type <VN::Limit>					stuff_depth
%type <VN::Itemisation>				itemisation items_bare items_sep
%type <VN::Item>					item
%type <shared_ptr<VN::Gnomon>>		designation_command 
%type <shared_ptr<VN::Gnomon>>		stuff_op_scope
%type <shared_ptr<VN::Gnomon>>		params_scope 
%type <shared_ptr<VN::RegularScopeGnomon>>		code_unit_scope compound_scope  
%type <VN::NodeAndGnomon>			norm_full_explicit_start type_full_explicit_start decl_full_explicit_start qual_full_explicit_start mi_full_explicit_start
%type <VN::NodeAndGnomon>			record_scope enum_scope
%type <TreePtr<Node>> 				stmt_decl_clause stmt_decl_disj stmt_decl_conj
%type <list<TreePtr<Node>>>			stmt_decls  
%type <list<TreePtr<Node>>>			members enumerators
%type <TreePtr<Node>> 				enumerator prototype_enumerator
%type <list<TreePtr<Node>>>			comma_sep_exprs semicolon_args parameters parameterisation
%type <list<TreePtr<Node>>>			bases memb_inits
%type <VN::QualifierData> 			qualifier qualifier_nw
%type <list<VN::QualifierData>>		qualifiers 
%type <multiset<string>>			type_specifier_seq
%type <TreePtr<Node>> 				declaring_type_id declaring_res_id declaring_st_res_id declaring_label_id
%type <shared_ptr<VN::PrerestrictScopeGnomon>>         prerestrict_decl_start

// Solve the dangling-else amiguity by giving the "else" token a higher priority than the "if" token
// In the rule, we must set the no-else rule to the "if" priority using %prec. Then, the TOKEN
// for "else" will be compared with the RULE for no-else case and highest precidence will win.
// It's all rather brittle.
%precedence KEYWORD_CONTROL_STMT // basically "then"
%precedence ELSE_KEYWORD  		   // basically "else"

%%

// Terminology
// x_boot is lowest prec for x, typically allowing VN commands
// x_clause is between VN commands and con/disjunction
// x is between con/disjunction and infix/space-sep syntaxes
// x_prefix x_postfix and x_primary are the expressional C and VN forms as indicated

//////////////////////////////////// COMMANDS ///////////////////////////////////////////

vnscript 		: commands 								{ vn->OnVNScript($1); }
     
// This is to make the ⨟ optional on last command
commands        : sep_commands								{ $$ = $1; }
				| sep_commands COMMAND_TERM					{ $$ = $1; }
				
// The ⨟ turns patterns into commands. 
sep_commands 	: sep_commands COMMAND_TERM script_command		{ $$ = $1; $$.push_back($3); }	
				| script_command								{ $$.push_back($1); }
				| sep_commands COMMAND_TERM designation_command	{ $$ = $1; recogniser->AddGnomon($3); }	
				| designation_command							{ recogniser->AddGnomon($1); }
			
// Add more commands here
script_command	: ENGINE_COMMAND unified_clause   		 	{ $$ = make_shared<VN::EngineCommand>($2, @1); }
				| ATTRIBUTE_COMMAND		  					{ $$ = make_shared<VN::AttributeCommand>(@$); }

// or here
designation_command	: new_vn_name DESIGNATE_COMMAND norm_clause		 { $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_NORMAL); }
					| new_vn_name DESIGNATE_COMMAND type_clause			 { $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_TYPE); }
					| new_vn_name DESIGNATE_COMMAND qualifier_node		 { $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_QUAL); }
					| new_vn_name DESIGNATE_COMMAND ACC_NODE_KEYWORD	 { $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_ACCESS); }
					| new_vn_name DESIGNATE_COMMAND PREPROCESSOR_ID_SIGN { $$ = make_shared<VN::DesignationGnomon>($1, $3, YY::VNLangParser::token::TOK_DESIGNATED_NORMAL); }
					
//////////////////////////////////// ITEMISATION ///////////////////////////////////////////
// For explicit/built-in nodes mostly

itemisation	: OPEN_VN items_bare CLOSE_VN  			{ $$ = $2; $$.loc = @$; }
			| OPEN_VN items_sep CLOSE_VN			{ $$ = $2; $$.loc = @$; $$.items.push_back({{}, @3}); }
			| OPEN_VN CLOSE_VN						{ $$.loc = @$; }
					
items_bare 	: items_sep item						{ $$ = $1; $$.items.push_back($2); }
			| item									{ $$.items.push_back($1); }

items_sep 	: items_bare VN_SEP		   				{ $$ = $1; } 
			| items_sep VN_SEP		 				{ $$ = $1; $$.items.push_back({{}, @2}); }
			| VN_SEP	 							{ $$.items.push_front({{}, @1}); }

item		: item VN_SUB_SEP unified_clause			{ $$ = $1; $$.nodes.push_back($3); $$.loc = @$; }
			| unified_clause							{ $$.nodes.push_back($1); $$.loc = @$; }

//////////////////////////////// UNIFIED ////////////////////////////////////         

unified_boot	: unified_clause								
				| unified_commands									{ $$ = vn->OnEmbeddedCommands($1); }

unified_commands: unified_clause COMMAND_TERM commands				{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 

// Entry is like boot but without commands
unified_clause	: norm_clause
				| type_clause
				| qualifier_node		
				| PREPROCESSOR_ID_SIGN	

unified_prefix	: expr_prefix
				| type_prefix
  
//////////////////////////////// COMPOUND ////////////////////////////////////         

//compound_boot	: compound								
//				| compound_commands										{ $$ = vn->OnEmbeddedCommands($1); }

//compound_commands	: compound COMMAND_TERM commands					{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 

// Because there's no separator in {{code} expr} the prefix ops would conflict with infix that use same symbol,
// so we'll need to complete a branch of the syntax for compounds with a copy of the unary VN operators (none are postfix).
compound	: compound_prefix

compound_prefix : compound_primary 
				| 								NEGATION_OP compound_prefix	{ $$ = vn->OnNegation($2); }
				|       				 TRANSFORM_NAME_NORMAL compound_prefix	{ $$ = vn->OnTransform($1, @1, $2, @2); }
				|  								   stuff_op_scope compound_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
				|    stuff_op_scope OPEN_VN unified_boot CLOSE_VN compound_prefix	{ $$ = vn->OnStuff($5, $3, VN::Limit()); }
				|     stuff_op_scope OPEN_VN stuff_depth CLOSE_VN compound_prefix	{ $$ = vn->OnStuff($5, nullptr, $3); }
				|                              PRERESTRICT_NORMAL compound_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }

compound_primary	: compound_scope '}'                					{ $$ = $1->scope_node; } 
					| compound_scope stmt_decls '}'    		 				{ $$ = $1->scope_node->OnStatements($2, @2); }
					| code_unit_scope stmt_decls '}' 						{ $$ = $1->scope_node->OnMembers($2, @2); }

compound_scope	: '{'														{ $$ = make_shared<VN::RegularScopeGnomon>(MakeTreeNode<CPPTree::Compound>()); 
																			  vn->AddGnomon($$); }
				| COMPOUND_SIGN '{'											{ $$ = make_shared<VN::RegularScopeGnomon>($1); 
																			  vn->AddGnomon($$); }
																			  
code_unit_scope	: CODE_UNIT '{'												{ $$ = make_shared<VN::RegularScopeGnomon>(MakeTreeNode<CPPTree::CodeUnit>()); 
																			  vn->AddGnomon($$); }

//////////////////////////////// DECLARATIONS ////////////////////////////////////         

declaration	: bare_declaration ';'								
			| comp_declaration									
			
comp_declaration: prototype compound									{ $$ = $1->OnInitialiser($2, @2); }			
				| access comp_declaration								{ $$ = $2; }
				
bare_declaration: prototype
				| prototype bare_initialiser							{ $$ = $1->OnInitialiser($2, @2); } 
				| prototype ':' memb_inits bare_initialiser				{ $$ = $1->OnMemberInits($3, @3); 
																		  $$ = $1->OnInitialiser($4, @4); } 
				| record
				| enum				
				| access bare_declaration								{ $$ = $2; }
				
bare_initialiser: C_ASSIGN assign_init									{ $$ = $2; } 
				| DESIGNATED_NORMAL		
				| INIT_SIGN							
			
// Note: C++ grammar allows to go directly into declarator, but we don't since we want to resolve "real" declarators 
// immediately, and don't want to invoke that mechanism for things that turn out to be something other than a prototype.
// Use of strict declarators with DESIGNATED_CURRENT_RECORD_ID is for constructors. See See #919.
prototype		: type_for_declarator declarator						{ $$ = vn->OnDeclaratorDecl({}, $1, @1, $2, @2); }	
				| qualifiers type_for_declarator declarator				{ $$ = vn->OnDeclaratorDecl($1, $2, @2, $3, @3); } // eg const int a	
				| type_for_declarator qualifiers declarator				{ $$ = vn->OnDeclaratorDecl($2, $1, @1, $3, @3); } // eg int const a 	
				| qualifiers type_for_declarator qualifiers declarator	{ $$ = vn->OnDeclaratorDecl($1+$3, $2, @2, $4, @4); } 
				| DESIGNATED_CURRENT_RECORD_ID st_declarator						{ $$ = vn->OnDeclaratorDecl({}, $1, @1, $2, @2); }	
				| qualifiers DESIGNATED_CURRENT_RECORD_ID st_declarator				{ $$ = vn->OnDeclaratorDecl($1, $2, @2, $3, @3); } // eg const int a	
				| DESIGNATED_CURRENT_RECORD_ID qualifiers st_declarator				{ $$ = vn->OnDeclaratorDecl($2, $1, @1, $3, @3); } // eg int const a 	
				| qualifiers DESIGNATED_CURRENT_RECORD_ID qualifiers st_declarator	{ $$ = vn->OnDeclaratorDecl($1+$3, $2, @2, $4, @4); } 
				| DESIGNATED_CURRENT_RECORD_ID parameterisation id_primary				{ $$ = vn->OnXStructorDecl(true, @$)->OnParams($2, @2)->OnIdentifier($3, @3); }
				| '~' DESIGNATED_CURRENT_RECORD_ID parameterisation id_primary				{ $$ = vn->OnXStructorDecl(true, @$)->OnParams($3, @3)->OnIdentifier($4, @4); }
				| qualifiers '~' DESIGNATED_CURRENT_RECORD_ID parameterisation id_primary		{ $$ = vn->OnXStructorDecl(true, @$)->OnParams($4, @4)->OnIdentifier($5, @5); $$ = vn->ApplyQualifiers($$, $1, @1); }
				| RESOURCE_SIGN id_parens								{ $1->OnInScope(vn->TryGetTopScopeGnomon(), @1); $$ = $1->OnIdentifier($2, @2); }

assign_init		: expression
				| '{' '}'             				  					{ $$ = vn->OnArrayInitialiser()->OnArgsList({}, @1+@2); } 
				| '{' comma_sep_exprs '}'      							{ $$ = vn->OnArrayInitialiser()->OnArgsList($2, @2); }               
			                                                                                                                   
memb_inits	: memb_inits ',' memb_init							{ $$ = $1; $$.push_back($3); }
			| memb_init											{ $$ = {$1}; }

memb_init_boot	: memb_init

memb_init	: memb_init_prefix
        
memb_init_prefix: memb_init_postfix
				| 						        GREEN_GRASS_OP memb_init_prefix	{ $$ = vn->OnGrass($2); }
				| 					               NEGATION_OP memb_init_prefix	{ $$ = vn->OnNegation($2); }
				|                        PRERESTRICT_MEMB_INIT memb_init_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
				|  						        stuff_op_scope memb_init_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
				|    stuff_op_scope OPEN_VN memb_init_boot CLOSE_VN memb_init_prefix	{ $$ = vn->OnStuff($5, $3, VN::Limit()); }
				|  stuff_op_scope OPEN_VN stuff_depth CLOSE_VN memb_init_prefix	{ $$ = vn->OnStuff($5, nullptr, $3); }
        
memb_init_postfix	: memb_init_primary
					| memb_init_primary '(' norm_boot ')'						{ $$ = vn->OnMemberInitialiser($1, @2, $3, @3); } 

memb_init_primary	: '(' memb_init_boot ')'                          			{ $$ = $2; }
					| DELTA_COMPARE_OP memb_init_boot DELTA_REPLACE_OP memb_init_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); } 
					| mi_full_explicit_start itemisation						{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
					| DESIGNATED_NORMAL
					| vn_wildcard
                     
mi_full_explicit_start 	: EXPLICIT_MEMB_INIT						{ $$ = vn->MakeScopeGnomonForNode($1); 
																	  vn->AddGnomon($$.gnomon); }

//////////////////////////////// CONCRETE DECLARATORS /////////////////////////////////////         
                          		
declarator			: declarator_prefix		

declarator_prefix	: declarator_postfix
					|                          '&' declarator_prefix { $$ = make_shared<Declarators::Reference>($2); } 
					|                          '*' declarator_prefix { $$ = make_shared<Declarators::Pointer>(Declarators::CVQuals(), $2); } 
					|               '*' qualifiers declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->ExtractCVQuals($2), $3); } 

declarator_postfix	: declarator_primary
					| declarator_postfix parameterisation			{ $$ = make_shared<Declarators::Function>($1, $2, Declarators::CVQuals()); }               
					| declarator_postfix parameterisation qualifiers{ $$ = make_shared<Declarators::Function>($1, $2, vn->ExtractCVQuals($3)); } 
					| declarator_postfix '[' expr_boot ']'			{ $$ = make_shared<Declarators::Array>($1, $3); } 
					| declarator_postfix '[' ']'					{ $$ = make_shared<Declarators::Array>($1, MakeTreeNode<CPPTree::Uninitialised>()); } 
                
declarator_primary	: declaring_res_id									{ $$ = make_shared<Declarators::Concrete>($1); } 
                     
//////////////////////////////// STRICT CONCRETE DECLARATORS /////////////////////////////////////         
// Strict means no parens around the central identifier
                          		
st_declarator			: st_declarator_prefix		

st_declarator_prefix	: st_declarator_postfix
						|                          '&' st_declarator_prefix { $$ = make_shared<Declarators::Reference>($2); } 
						|                          '*' st_declarator_prefix { $$ = make_shared<Declarators::Pointer>(Declarators::CVQuals(), $2); } 
						|               '*' qualifiers st_declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->ExtractCVQuals($2), $3); } 

st_declarator_postfix	: st_declarator_primary
						| st_declarator_postfix parameterisation			{ $$ = make_shared<Declarators::Function>($1, $2, Declarators::CVQuals()); }               
						| st_declarator_postfix parameterisation qualifiers { $$ = make_shared<Declarators::Function>($1, $2, vn->ExtractCVQuals($3)); } 
						| st_declarator_postfix '[' expr_boot ']'			{ $$ = make_shared<Declarators::Array>($1, $3); } 
						| st_declarator_postfix '[' ']'						{ $$ = make_shared<Declarators::Array>($1, MakeTreeNode<CPPTree::Uninitialised>()); } 
                
st_declarator_primary	: declaring_st_res_id  								{ $$ = make_shared<Declarators::Concrete>($1); } 
                     
//////////////////////////////// ABSTRACT DECLARATORS /////////////////////////////////////         
                          		
ab_declarator			: ab_declarator_prefix									 

ab_declarator_prefix	: ab_declarator_postfix
						|                          '&' ab_declarator_prefix { $$ = make_shared<Declarators::Reference>($2); } 
						|                          '*' ab_declarator_prefix { $$ = make_shared<Declarators::Pointer>(Declarators::CVQuals(), $2); } 
						|               '*' qualifiers ab_declarator_prefix { $$ = make_shared<Declarators::Pointer>(vn->ExtractCVQuals($2), $3); } 
						|                      	      		 		 	'&' { $$ = make_shared<Declarators::Reference>(nullptr); }  
						|                           				 	'*' { $$ = make_shared<Declarators::Pointer>(Declarators::CVQuals(), nullptr); } 
						|                          		  	 '*' qualifiers { $$ = make_shared<Declarators::Pointer>(vn->ExtractCVQuals($2), nullptr); } 

ab_declarator_postfix	: ab_declarator_postfix parameterisation			{ $$ = make_shared<Declarators::Function>($1, $2, Declarators::CVQuals()); }          
ab_declarator_postfix	: ab_declarator_postfix parameterisation qualifiers	{ $$ = make_shared<Declarators::Function>($1, $2, vn->ExtractCVQuals($3)); }        
						| ab_declarator_postfix '[' expr_boot ']'			{ $$ = make_shared<Declarators::Array>($1, $3); } 
						| parameterisation									{ $$ = make_shared<Declarators::Function>(nullptr, $1, Declarators::CVQuals()); }   
						| parameterisation qualifiers						{ $$ = make_shared<Declarators::Function>(nullptr, $1, vn->ExtractCVQuals($2)); }   
						| '[' expr_boot ']'									{ $$ = make_shared<Declarators::Array>(nullptr, $2); }                 		
						| '[' ']'											{ $$ = make_shared<Declarators::Array>(nullptr, MakeTreeNode<CPPTree::Uninitialised>()); } 

//////////////////////////////////////// PARAMETERS /////////////////////////////////////////////

parameterisation	: params_scope parameters ')'				{ $$ = $2; }
					| params_scope ')'							{ $$.clear(); }							

params_scope	: '(' 											{ $$ = make_shared<VN::ParameterisationScopeGnomon>(); 
																  vn->AddGnomon($$); } 

parameters	: parameter												{ $$.push_back($1); }
			| parameters ',' parameter								{ $$ = $1; $$.push_back($3); }			
				
parameter   : norm_clause    
                         
//////////////////////////////// RECORDS ////////////////////////////////////                                  
                         
record			: record_scope '{' members '}'			 				{ $$ = $1.node->OnMembers($3, @3); }
				| record_scope ':' bases '{' members '}'				{ $$ = $1.node->OnBases($3, @3)->OnMembers($5, @5); }
				| record_scope '{' '}'			 						{ $$ = $1.node; }
				| record_scope ':' bases '{' '}'						{ $$ = $1.node->OnBases($3, @3); }
             
record_scope    : RECORD_KEYWORD declaring_type_id        						{ $$ = { $1->OnIdentifier($2, @2),  
																		             vn->MakeRecordScopeGnomon($1) }; 
																			  vn->AddGnomon($$.gnomon); } 
																			                                                  
bases			: base_spec                                                 { $$.push_back($1); } 
				| bases ',' base_spec										{ $$ = $1; $$.push_back($3); } 
                                       
base_spec		: type_specified											{ $$ = vn->OnBase($1); } 
				| vn_wildcard												{ $$ = $1; }
				| DESIGNATED_NORMAL       				  					// To match a designated Star
				| bare_access type_specified								{ $$ = vn->OnBase($1, $2, @$); }
                                                                                                                                                         				                      				                        
//////////////////////////////// ACCESS/MEMBER ////////////////////////////////////                                  
				                                 
// Acc Memb column includes access specifiers and full member declarations. We combine both because
// a member can start with both, and the parser has limited lookahead. By being explicit, we avoid the 
// brittleness of symmetrical columns. This will make eg (int a) : char b; syntactical (i.e. if 
// legitimised by a VN or paren, a declaration could be used as an access specifier). TODO prevent in Actions.

// Note: booting into here permits an access spec before a decl eg public: int a;
// This is done to allow a "localised" access spec in booted contexts eg delta.

// Above, loopbacks. Below, entry from record

members			: declaration												{ $$.push_back($1); }
//				| access													{ $$ = {}; }
				| expr_prefix ';'											{ $$.push_back($1); }
				| members declaration 										{ $$ = $1; $$.push_back($2); }
//				| members access									
				| members expr_prefix ';'									{ $$ = $1; $$.push_back($2); }
				
access			: access_primary ':'										{ $$ = $1; vn->UpdateCurrentAccess(@1, $1); }				
				
access_primary	: bare_access
				| access_wildcard

access_wildcard 	: STAR_IN_RECORD									{ $$ = vn->OnStar(nullptr); }
					| STAR_IN_RECORD OPEN_VN star_arg CLOSE_VN			{ $$ = vn->OnStar($3); }
					| ANY_NODE_IN_RECORD								{ $$ = nullptr; }

bare_access		: ACC_NODE_KEYWORD 
                | DESIGNATED_ACCESS
					
//////////////////////////////// ENUMERATIONS ////////////////////////////////////                                  
                         
enum			: enum_scope '{' enumerators '}'		 					{ $$ = $1.node->OnMembers( $3, @3 ); }
				| enum_scope '{' '}'		 								{ $$ = $1.node; }
             
enum_scope      : enum_node declaring_type_id       							{ $$ = { $1->OnIdentifier($2, @2), 
																		                 vn->MakeRecordScopeGnomon($1) }; 
																				  vn->AddGnomon($$.gnomon); } 
																			  
enum_node		: ENUM_KEYWORD												
                                                                                                                                                       
enumerators		: enumerator												{ $$.push_back($1); }
				| enumerators ',' enumerator 								{ $$ = $1; $$.push_back($3); }

// TODO Eventually to resemble the cyclic structure of declarations
enumerator		: prototype_enumerator
				| prototype_enumerator C_ASSIGN assign_init					{ $$ = $1->OnInitialiser($3, @3); } 

prototype_enumerator 		: id_parens 									{ $$ = vn->OnEnumerator(@1)->OnIdentifier( $1, @1 ); }

//////////////////////////////// STATEMENTS ////////////////////////////////////                 

norm_boot		: norm_clause 
				| norm_commands								{ $$ = vn->OnEmbeddedCommands($1); }

norm_commands	: norm_clause COMMAND_TERM commands			{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 

norm_clause		: normal_disj
       
normal_disj		: normal_conj
				| normal_disj DISJUNCTION_OP normal_conj		{ $$ = vn->OnDisjunction($1, $3); }

normal_conj 	: normal       
				| normal_conj CONJUNCTION_OP normal   		{ $$ = vn->OnConjunction($1, $3); }
		
normal    		: statement		
				| expression
				| declaration			
				| bare_declaration			// TODO don't like this, add the semicolons during render
				| other_wildcard ':'               			{ $$ = vn->OnLabel($1, @1); } // treat as label because an access spec on its own doesn't produce a node
//				| access declaration             			{ $$ = $2; }
//				| access bare_declaration             			{ $$ = $2; } 	// TODO don't like this, add the semicolons during render
							
stmt_decls		: stmt_decl_clause											            { $$ = {$1}; } 
				| stmt_decl_clause stmt_decls											{ $$ = $2; $$.push_front($1); }

stmt_decl_clause	: stmt_decl_disj

stmt_decl_disj	: stmt_decl_conj
				| stmt_decl_disj DISJUNCTION_OP stmt_decl_conj	{ $$ = vn->OnDisjunction($1, $3); }

stmt_decl_conj	: stmt_decl       
				| stmt_decl_conj CONJUNCTION_OP stmt_decl  		{ $$ = vn->OnConjunction($1, $3); }

stmt_decl		: statement										
				| declaration			
//				| access declaration		             			{ $$ = $2; }												
					
statement		: statement_nc												
				| compound	
			
statement_nc	: statement_nca												
				| arrival

// Note: as of C++23, a compound statement CAN and in a label. So, we take the fully general 
// approach here and parse a label (up to and including the :) as a full statement. No need
// to try and absorb extra semicolons introduced by render: they've gone too. 
// #903 generalise to comma separated args
arrival		: ARRIVAL_KEYWORD ':'										
			| ARRIVAL_KEYWORD expression ':'								{ $$ = $1->OnArgsList({$2}, @2); } 
			| ARRIVAL_KEYWORD expression RANGE_OP expression ':' 			{ $$ = $1->OnArgsList({$2, $4}, @2+@4); }
			| declaring_label_id ':' 			 							{ $$ = vn->OnLabel($1, @1); } 
			| label_wildcard ':' 			 								{ $$ = vn->OnLabel($1, @1); } 

label_wildcard 	: STAR_IN_COMPOUND									{ $$ = vn->OnStar(nullptr); }
				| STAR_IN_COMPOUND OPEN_VN star_arg CLOSE_VN		{ $$ = vn->OnStar($3); }
				| ANY_NODE_IN_COMPOUND								{ $$ = nullptr; }

statement_nca	: bare_statement ';'										
				| control_stmt_sign '(' ')' statement	
			  	  %prec KEYWORD_CONTROL_STMT								{ $$ = $1->OnArgsList({}, @2+@3)->OnBody($4, @4); }
				| control_stmt_sign '(' semicolon_args ')' statement	
				  %prec KEYWORD_CONTROL_STMT								{ $$ = $1->OnArgsList($3, @3)->OnBody($5, @5); }
				| control_stmt_sign '(' semicolon_args ')' statement
				  ELSE_KEYWORD statement									{ $$ = $1->OnArgsList($3, @3)->OnBody($5, @5)->OnElseBody($7, @6); }
				| ';'														{ $$ = vn->OnNop(@1); }      

bare_statement	: KEYWORD_SIMPLE_STMT										
				| KEYWORD_SIMPLE_STMT expression							{ $$ = $1->OnArgsList({$2}, @2); }
				| DO_KEYWORD statement WHILE_KEYWORD '(' norm_boot ')'	{ $$ = $1->OnBody($2, @2)->OnArgsList({$5}, @5); } // TODO a While node is gobbled up here
				| expression 											// TODO Should come in under bare_statement but conflicts #905

control_stmt_sign 	: KEYWORD_CONTROL_STMT
					| WHILE_KEYWORD
						
semicolon_args	: expression												{ $$.push_back($1); }
				| semicolon_args ';' expression								{ $$ = $1; $$.push_back($3); }

//////////////////////////////// EXPRESSIONS ////////////////////////////////////         

expr_boot		: expr_clause 
				| expr_commands										{ $$ = vn->OnEmbeddedCommands($1); }

expr_commands   : expr_clause COMMAND_TERM commands					{ $$ = $3; $$.push_front( make_shared<VN::PatternCommand>($1, @1) ); } 
     
expr_clause		: expr_disjunction

expr_disjunction	: expr_conjunction
					| expr_disjunction DISJUNCTION_OP expr_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

expr_conjunction 	: expression       
					| expr_conjunction CONJUNCTION_OP expression		  	{ $$ = vn->OnConjunction($1, $3); }
     
expression			: expr_comma_op
                                   
expr_comma_op       : expr_no_comma_op
// Operator comma removed due to ambiguity with ∧ and ∨. Comma is lower in the case of eg parameters but higher here.
//                    | expr_comma_op ',' expr_no_comma_op						{ $$ = vn->OnInfixOperator(",")->OnArgsList({$1, $3}, @$); }  
                    
expr_no_comma_op 	: expr_id_value

expr_id_value		: expr_assignment
					| expr_id_value MAP_ARG_OP expr_assignment					{ $$ = vn->OnIdValuePair()->OnArgsList({$1, $3}, @$); }
					
expr_assignment 	: expr_logical_or 
					| 				   expr_logical_or C_ASSIGN expr_assignment	{ $$ = vn->OnInfixOperator($2)->OnObject($1, @1)->OnArgsList({$3}, @3); }
					|         expr_logical_or C_ASSIGNMENT_OP expr_assignment	{ $$ = vn->OnInfixOperator($2)->OnObject($1, @1)->OnArgsList({$3}, @3); }
					|   	 expr_logical_or '?' expression ':' expr_assignment	{ $$ = vn->OnConditionalOperator()->OnArgsList({$1, $3, $5}, @$); }

expr_logical_or 	: expr_logical_and
					| expr_logical_or C_LOGICAL_OR_OP expr_logical_and			{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
		
expr_logical_and	: expr_bitwise_or
					| expr_logical_and C_LOGICAL_AND_OP expr_bitwise_or			{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }

expr_bitwise_or 	: expr_bitwise_xor
					| expr_bitwise_or C_BITWISE_OR_OP expr_bitwise_xor			{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
		
expr_bitwise_xor	: expr_bitwise_and
					| expr_bitwise_xor C_BITWISE_XOR_OP expr_bitwise_and		{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
		
expr_bitwise_and	: expr_equality
					| expr_bitwise_and '&' expr_equality						{ $$ = vn->OnInfixOperator("&")->OnArgsList({$1, $3}, @$); }

expr_equality 		: expr_relational
					| expr_equality C_EQUALITY_OP expr_relational				{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }

expr_relational 	: expr_shift
					| expr_relational C_RELATIONAL_OP expr_shift				{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }

expr_shift			: expr_add_etc
					| expr_shift C_SHIFT_OP expr_add_etc						{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
		
expr_add_etc 		: expr_mul_etc
					| expr_add_etc C_ADD_SUB_OP expr_mul_etc					{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
		
expr_mul_etc 		: expr_prefix
					| expr_mul_etc C_DIV_MOD_OP expr_prefix						{ $$ = vn->OnInfixOperator($2)->OnArgsList({$1, $3}, @$); }
					| expr_mul_etc '*' expr_prefix								{ $$ = vn->OnInfixOperator("*")->OnArgsList({$1, $3}, @$); }
		
expr_prefix : expr_postfix
			| 					            C_PREFIX_OP	expr_prefix	{ $$ = vn->OnPrefixOperator($1)->OnArgsList({$2}, @2); }
			| 					                    '&' expr_prefix	{ $$ = vn->OnPrefixOperator("&")->OnArgsList({$2}, @2); }
			| 					                    '*' expr_prefix	{ $$ = vn->OnPrefixOperator("*")->OnArgsList({$2}, @2); }
			| 					                    '~' expr_prefix	{ $$ = vn->OnPrefixOperator("~")->OnArgsList({$2}, @2); }
			| 					           C_ADD_SUB_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1)->OnArgsList({$2}, @2); }
			| 					      C_PRE_OR_INFIX_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1)->OnArgsList({$2}, @2); }
			| 					    C_PRE_OR_POSTFIX_OP expr_prefix	{ $$ = vn->OnPrefixOperator($1)->OnArgsList({$2}, @2); }
			| 						     GREEN_GRASS_OP expr_prefix	{ $$ = vn->OnGrass($2); }
			| 						      POINTER_IS_OP expr_prefix	{ $$ = vn->OnPointerIs($2); }
			| 					         	NEGATION_OP	expr_prefix	{ $$ = vn->OnNegation($2); }
			|                        PRERESTRICT_NORMAL expr_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|                PRERESTRICT_MEMB_INIT memb_init_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|        		     prerestrict_decl_start expr_prefix	{ $$ = vn->OnRestrict($1->node, @1, $2, @2); }
			|  						        stuff_op_scope unified_prefix	{ $$ = vn->OnStuff($2, nullptr, VN::Limit()); }
			| stuff_op_scope OPEN_VN unified_boot CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, $3, VN::Limit()); }
			|  stuff_op_scope OPEN_VN stuff_depth CLOSE_VN unified_prefix { $$ = vn->OnStuff($5, nullptr, $3); }
			|                          BUILD_SIZE_OP unified_prefix { $$ = vn->OnBuildSize($2); }
			|                           STRINGIZE_OP unified_prefix { $$ = vn->OnStringize($2); }

// This one dips into ASCII/C because VN doesn't otherwise need equality/inequality operators
stuff_depth		: C_ASSIGN INTEGRAL_LITERAL							{ $$ = VN::Limit{ $1, @1, $2, @2 }; }

// Postfix operators are treated like method calls, operand is regarded as object
expr_postfix: expr_primary     
			| expr_postfix C_PRE_OR_POSTFIX_OP 				 		{ $$ = vn->OnPostfixOperator($2)->OnObject($1, @1); }
			| expr_postfix '[' expr_boot ']'	 					{ $$ = vn->OnSubscript()->OnObject($1, @1)->OnArgsList({$3}, @3); }
			| expr_postfix argumentation							{ $$ = vn->OnCall()->OnObject($1, @1)->OnArgumentation($2, @2); } 
			| expr_postfix '.' id_parens							{ $$ = vn->OnLookup()->OnObject($1, @1)->OnArgsList({$3}, @3); }
			| LIBRARY_FUNC '(' comma_sep_exprs ')'   				{ $$ = $1->OnArgsList($3, @3); }	
			| LIBRARY_FUNC '(' ')'   							
			| expr_postfix '.' LIBRARY_METHOD '(' comma_sep_exprs ')' 	{ $$ = $3->OnObject($1, @1)->OnArgsList($5, @5); }			
			| expr_postfix '.' LIBRARY_METHOD '(' ')'   				{ $$ = $3->OnObject($1, @1); }			
			| FUNC_ON_TYPE '(' type_boot ')'       						{ $$ = $1->OnType($3, @3); }			
		
expr_primary: id_extras
			| norm_primary  
			| INTEGRAL_LITERAL					      			{ $$ = vn->OnIntegralLiteral($1, @1); }
			| STRING_LITERAL					      			{ $$ = vn->OnStringLiteral($1); }
			| BOOL_LITERAL									
			| KEYWORD_PRIMARY_OP							
			| INIT_SIGN
			
norm_primary	: vn_primary
				| '(' norm_boot ')'                       			{ $$ = $2; }
				| vn_wildcard
			
prerestrict_decl_start : PRERESTRICT_DECL     				    { $$ = make_shared<VN::PrerestrictScopeGnomon>($1); 
                                                                  vn->AddGnomon($$); }		
			
//////////////////////////////// DECLARING IDS ////////////////////////////////////                 
// Identifiers to use in C declaring constructs. We can designate here.

declaring_type_id	: type_specified		
                    | new_vn_name			{ recogniser->AddGnomon(
                                              make_shared<VN::DesignationGnomon>($1, 
                                                                                 MakeTreeNode<CPPTree::TypeIdentifier>(), 
                                                                                 YY::VNLangParser::token::TOK_DESIGNATED_NORMAL)); }

declaring_res_id	: id_parens
                    | new_vn_name			{ recogniser->AddGnomon(
                                              make_shared<VN::DesignationGnomon>($1, 
                                                                                 MakeTreeNode<CPPTree::ResourceIdentifier>(), 
                                                                                 YY::VNLangParser::token::TOK_DESIGNATED_NORMAL)); }

declaring_st_res_id	: id_primary
					| vn_wildcard
                    | new_vn_name			{ recogniser->AddGnomon(
                                              make_shared<VN::DesignationGnomon>($1, 
                                                                                 MakeTreeNode<CPPTree::ResourceIdentifier>(), 
                                                                                 YY::VNLangParser::token::TOK_DESIGNATED_NORMAL)); }

declaring_label_id	: id_primary
                    | new_vn_name			{ recogniser->AddGnomon(
                                              make_shared<VN::DesignationGnomon>($1, 
                                                                                 MakeTreeNode<CPPTree::LabelIdentifier>(), 
                                                                                 YY::VNLangParser::token::TOK_DESIGNATED_NORMAL)); }

//////////////////////////////// IDENTIFIERS ////////////////////////////////////         

id_boot			: id_disjunction

id_disjunction	: id_conjunction
				| id_disjunction DISJUNCTION_OP id_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

id_conjunction 	: id_prefix       
				| id_conjunction CONJUNCTION_OP id_prefix   		{ $$ = vn->OnConjunction($1, $3); }

id_prefix	: id_parens
 			| 						     GREEN_GRASS_OP id_prefix	{ $$ = vn->OnGrass($2); }
			| 						      POINTER_IS_OP id_prefix	{ $$ = vn->OnPointerIs($2); }
			| 					         	NEGATION_OP	id_prefix	{ $$ = vn->OnNegation($2); }
			|                        PRERESTRICT_NORMAL id_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); } // Note: we could recognise PRERESTRICT_ID if this casues conflicts

id_parens	: id_primary
			| vn_wildcard
			| '(' id_boot ')'										{ $$ = $2; }

id_primary  : id_extras
			| vn_primary

id_extras	: norm_full_explicit_start itemisation							{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
			| NORMAL_ID_SIGN	  			
			| ID_BY_NAME_NORMAL OPEN_VN STRING_LITERAL CLOSE_VN				{ $$ = vn->OnIdByName($1, @1, $3, @3); } 
			| ID_BUILDER_NORMAL OPEN_VN STRING_LITERAL VN_SEP CLOSE_VN 		{ $$ = vn->OnBuildId($1, @1, $3, @3, VN::Item{}); }
			| ID_BUILDER_NORMAL OPEN_VN STRING_LITERAL VN_SEP item CLOSE_VN	{ $$ = vn->OnBuildId($1, @1, $3, @3, $5); }
			| ID_BUILDER_NORMAL OPEN_VN VN_SEP item CLOSE_VN 				{ $$ = vn->OnBuildId($1, @1, wstring(), @3, $4); }
			
argumentation	: OPEN_MAP_CALL comma_sep_exprs CLOSE_MAP_CALL	{ $$ = vn->OnMapArgs()->OnArgsList($2, @2); }
				| OPEN_MAP_CALL CLOSE_MAP_CALL					{ $$ = vn->OnMapArgs(); }
				| '(' comma_sep_exprs ')'						{ $$ = vn->OnSeqArgs()->OnArgsList($2, @2); }
				| '(' ')'	 									{ $$ = vn->OnSeqArgs(); }

comma_sep_exprs	: expr_no_comma_op								{ $$.push_back($1); }
				| comma_sep_exprs ',' expr_no_comma_op			{ $$ = $1; $$.push_back($3); }			

norm_full_explicit_start : EXPLICIT_NORMAL							{ $$ = vn->MakeScopeGnomonForNode($1); 
																	  vn->AddGnomon($$.gnomon); }
																	  
//////////////////////////////// NORMAL ////////////////////////////////////         

vn_primary 		: DESIGNATED_NORMAL
				| DELTA_COMPARE_OP norm_boot DELTA_REPLACE_OP norm_boot DELTA_END_OP	{ $$ = vn->OnDelta($2, $4); }
				| TRANSFORM_NAME_NORMAL OPEN_VN unified_boot CLOSE_VN	{ $$ = vn->OnTransform($1, @1, $3, @3); }
				| decl_full_explicit_start itemisation					{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }

// Keep this long-hand for symmetry with versions that only allow eg ..._IN_RECORD
vn_wildcard 	: STAR_IN_RECORD									{ $$ = vn->OnStar(nullptr); }
				| STAR_IN_RECORD OPEN_VN star_arg CLOSE_VN			{ $$ = vn->OnStar($3); }
				| ANY_NODE_IN_RECORD								{ $$ = nullptr; }
				| STAR_IN_COMPOUND									{ $$ = vn->OnStar(nullptr); }
				| STAR_IN_COMPOUND OPEN_VN star_arg CLOSE_VN		{ $$ = vn->OnStar($3); }
				| ANY_NODE_IN_COMPOUND								{ $$ = nullptr; }
				| STAR_IN_OTHER										{ $$ = vn->OnStar(nullptr); }
				| STAR_IN_OTHER OPEN_VN star_arg CLOSE_VN			{ $$ = vn->OnStar($3); }
				| ANY_NODE_IN_OTHER									{ $$ = nullptr; }				
												
other_wildcard 	: STAR_IN_OTHER									{ $$ = vn->OnStar(nullptr); }
				| STAR_IN_OTHER OPEN_VN star_arg CLOSE_VN		{ $$ = vn->OnStar($3); }
				| ANY_NODE_IN_OTHER								{ $$ = nullptr; }
												
star_arg		: norm_boot
				| bare_access
	
															
decl_full_explicit_start 	: EXPLICIT_DECL								{ $$ = vn->MakeScopeGnomonForNode($1); 
																		  vn->AddGnomon($$.gnomon); }                                                                                  
										
//////////////////////////////// TYPE-ID ////////////////////////////////////         
// type-id as seen in https://alx71hub.github.io/hcb/#type-id can be troublesome grammatically. Care advised.

type_id 			: ab_type
                      
ab_type				: type_for_declarator ab_declarator 				 		{ $$ = vn->OnAbDeclType(@$, {}, $1, $2); }
					| qualifiers type_for_declarator ab_declarator 		 		{ $$ = vn->OnAbDeclType(@$, $1, $2, $3); }  
					| type_for_declarator qualifiers ab_declarator 		 		{ $$ = vn->OnAbDeclType(@$, $2, $1, $3); } 
					| qualifiers type_for_declarator qualifiers ab_declarator	{ $$ = vn->OnAbDeclType(@$, $1+$3, $2, $4); } 
					| type_for_declarator 				 						// abstract declarators can be "invisible"

//////////////////////////////// TYPES ////////////////////////////////////         
       
type_boot 			: type_clause

type_clause			: type_disjunction

type_disjunction	: type_conjunction
					| type_disjunction DISJUNCTION_OP type_conjunction		{ $$ = vn->OnDisjunction($1, $3); }

type_conjunction 	: type_specified
					| type_conjunction CONJUNCTION_OP type_specified		{ $$ = vn->OnConjunction($1, $3); }
                    										 								 			               
// Not including types that require declarators (except via built-in, designation etc)          
type_specified		: type_prefix          
          
type_prefix : type_postfix
			| 						         GREEN_GRASS_OP type_prefix	{ $$ = vn->OnGrass($2); }
			| 							      POINTER_IS_OP type_prefix	{ $$ = vn->OnPointerIs($2); }
			| 							        NEGATION_OP type_prefix	{ $$ = vn->OnNegation($2); }
			|                     		   PRERESTRICT_TYPE type_prefix	{ $$ = vn->OnRestrict($1, @1, $2, @2); }
			|								 TYPE_INDICATOR expr_prefix { $$ = $2; }

type_postfix: type_primary		   
			| DESIGNATED_CURRENT_RECORD_ID			  			
			      
// prevent typeised postfix expressions looking like declarators eg ⍑x[2] typeizes x[2] and you need (⍑x) [2] for an abstract type
type_for_declarator : type_primary						 			                			      
			                                       
type_primary: type_vn_prim
			| '(' type_boot ')'													{ $$ = $2; } // For disambiguation and introducing types using anonymous declarators
            | TYPE_SIGN														
            | TYPE_W_PARAMS_SIGN parameterisation								{ $$ = $1->OnParams($2, @2); }		
			| type_specifier_seq 												{ $$ = vn->OnTypeSpecifierSeq($1, @1); }				
			| TYPE_INDICATOR TYPE_INDICATOR '(' type_id ')'						{ $$ = $4; } // See #909
			
type_vn_prim: type_full_explicit_start itemisation								 { $$ = vn->FinishExplicitNode($1.node, @1, $2); }
			| DELTA_COMPARE_OP type_boot DELTA_REPLACE_OP type_boot DELTA_END_OP { $$ = vn->OnDelta($2, $4); }
			| DESIGNATED_TYPE     						
			| ID_BY_NAME_TYPE OPEN_VN STRING_LITERAL CLOSE_VN					 { $$ = vn->OnIdByName($1, @1, $3, @3); } 
			| ID_BUILDER_TYPE OPEN_VN STRING_LITERAL VN_SEP CLOSE_VN 			 { $$ = vn->OnBuildId($1, @1, $3, @3, VN::Item{}); }
			| ID_BUILDER_TYPE OPEN_VN STRING_LITERAL VN_SEP item CLOSE_VN 		 { $$ = vn->OnBuildId($1, @1, $3, @3, $5); }
			| ID_BUILDER_TYPE OPEN_VN VN_SEP item CLOSE_VN 						 { $$ = vn->OnBuildId($1, @1, wstring(), @3, $4); }
			| TRANSFORM_NAME_TYPE OPEN_VN unified_boot CLOSE_VN 				 { $$ = vn->OnTransform($1, @1, $3, @3); }
//			| star OPEN_VN type_boot CLOSE_VN									 { $$ = vn->OnStar($3); } // probably needs to be typalised to avoid conflict with wildcarded access spec
		 	
type_full_explicit_start 	: EXPLICIT_TYPE										{ $$ = vn->MakeScopeGnomonForNode($1); 
                                                                                  vn->AddGnomon($$.gnomon); }
                                                                                  
// eg "long unsigned int". VN represents this as a single node. We don't want nodes for its constituent parts.
// So, this is the level at which we mix in the VN syntax.
type_specifier_seq	: TYPE_SPECIFIER											{ $$.insert($1); }
					| TYPE_SPECIFIER type_specifier_seq							{ $$ = $2; $$.insert($1); }
                                                                              
//////////////////////////////// QUALIFIERS ////////////////////////////////////         

qualifiers		: qualifier													{ $$.push_back($1); }
				| qualifiers qualifier										{ $$ = $1; $$.push_back($2); }			

qualifier		: qualifier_nw
				
// No wildcards version
qualifier_nw	: qualifier_node											{ $$ = VN::QualifierData($$, VN::QualCat::NODE, $1); }
				| STATIC_KEYWORD											{ $$ = VN::QualifierData($$, VN::QualCat::STATIC); }
				| TYPEDEF_KEYWORD											{ $$ = VN::QualifierData($$, VN::QualCat::TYPEDEF, $1); }

qualifier_node	: qual_full_explicit_start itemisation						{ $$ = vn->FinishExplicitNode($1.node, @1, $2); }
				| QUAL_NODE_KEYWORD								
				| DESIGNATED_QUAL       				  			

qual_full_explicit_start : EXPLICIT_QUAL									{ $$ = vn->MakeScopeGnomonForNode($1); 
                                                                              vn->AddGnomon($$.gnomon); }

//////////////////////////////////////// RECOGNISER GLUE /////////////////////////////////////////////

new_vn_name		: NEW_UNICODE_NAME    						
				| NEW_ASCII_NAME								{ $$ = ToUnicode($1); }     										      

stuff_op_scope			: STUFF_OP			{ $$ = make_shared<VN::UnknownScopeGnomon>("stuff pattern"); 
											  vn->AddGnomon($$); }

%%
